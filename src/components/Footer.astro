---
import { getCollection } from 'astro:content';
import { FOOTER, STUDIO_EMAIL, NAV, BUILT_ROUTES } from '../lib/copy';

/**
 * COPY.md §1, footer.
 *
 * Step-1 review item 12: the location line was missing at every breakpoint on both
 * pages. It is COPY.md §1's own string and it is back.
 *
 * The "Elsewhere" group needed the founders' profile URLs, which live on the `people`
 * collection; that collection now exists, so the four outbound links ship. Four links
 * and no more (items 17 and 18).
 *
 * The nav repeat still points at four routes that are not built, so it is still out —
 * the same rule the header follows.
 */
const people = await getCollection('people');

/** COPY.md §1's four labels, verbatim, each resolved to that person's own URL. */
const elsewhere: { label: string; href: string }[] = [];
for (const entry of FOOTER.elsewhere) {
  const person = people.find((p) => p.data.slug === entry.person);
  if (person) elsewhere.push({ label: entry.label, href: person.data.socials[entry.social] });
}

const navRepeat = NAV.filter((item) => BUILT_ROUTES.has(item.href));
---

<footer class="site-footer">
  <div class="shell">
    <hr class="site-footer__rule" />
  </div>
  <div class="shell stack">
    <p>{FOOTER.studioLine}</p>
    <p>{FOOTER.locationLine}</p>
    <p>
      <a class="link" href={`mailto:${STUDIO_EMAIL}`}>{FOOTER.emailLabel}</a>
    </p>

    {
      navRepeat.length > 0 && (
        <nav aria-label="Footer">
          <ul class="site-footer__links">
            {navRepeat.map((item) => (
              <li>
                <a class="link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      elsewhere.length > 0 && (
        <section class="stack-tight" aria-labelledby="footer-elsewhere">
          <h2 id="footer-elsewhere" class="site-footer__heading">
            {FOOTER.elsewhereHeading}
          </h2>
          <ul class="site-footer__links small">
            {elsewhere.map((item) => (
              <li>
                <a class="link" href={item.href} target="_blank" rel="noopener noreferrer">
                  {item.label}
                  <span class="sr-only"> Opens a new tab.</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="small muted">{FOOTER.employerNote}</p>
    <p class="small muted">{FOOTER.rightsLine}</p>
  </div>
</footer>

<style>
  /*
    Step-2 review item 9: §B.8 and §B.9 both put the footer's nav repeat, the two
    GitHub lines and the micro lines INSIDE the final --floor block, and §B.9 names
    that block as what "bookends the room". The footer took --band, so the last fill
    on the page was a light panel and the room was bookended by a sheet. It takes the
    room's own ground now and follows the final CTA with no seam between them: the
    1px inset top edge §B.2a asks for belongs to the top of the inverted region, and
    the region starts at the CTA.
  */
  .site-footer {
    background-color: var(--tgd-room);
    color: var(--tgd-on-room);
    padding-block-start: var(--space-32);
    padding-block-end: var(--space-48);
    /* §B.2/§C.8 — inside the room the outer ring is --chalk, never --ink, because in
       the light scheme --ink resolves to the room's own ground. */
    --focus-outer: var(--tgd-on-room);
  }

  /* §B.9 draws a rule above the two GitHub lines; it separates the CTA's own block
     from the footer's inside one continuous floor. */
  .site-footer__rule {
    border: 0;
    border-block-start: 1px solid var(--rule-on-room);
    margin-block-end: var(--space-32);
  }

  .site-footer :global(.muted) {
    color: var(--tgd-on-room-muted);
  }

  /* COPY.md §10.5 — every outbound link says so in its own name; no icon carries it. */
  .site-footer__links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-32);
    row-gap: var(--space-4);
  }

  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
  }

  .site-footer__heading {
    font-size: var(--step-small);
    line-height: var(--step-small-lh);
    font-family: var(--tgd-font-body);
    font-weight: 600;
    color: var(--tgd-on-room-muted);
  }

  /*
    DESIGN.md §D.8 — paper cannot follow a link, so the nav repeat and the Elsewhere
    group do not print. The studio line, the location, the address and the employer note
    do: brief §5.4 requires the note wherever an employer name is printed, and a person
    page prints five of them.
  */
  @media print {
    .site-footer__links,
    .site-footer__heading {
      display: none;
    }

    /*
      §D.8's failure class, one layer down. The footer takes the room's ground so the page
      is bookended by the floor (§B.9), and its text is --chalk. On paper a browser
      suppresses the ground and leaves --chalk on white at 1.20 : 1 — an unreadable block
      produced silently. It prints as ink on paper with a rule above it instead, which is
      the separation the fill was carrying.
    */
    .site-footer {
      background-color: transparent;
      color: var(--floor);
      box-shadow: none;
      padding-block-start: var(--space-16);
      padding-block-end: 0;
      --tgd-on-room: var(--floor);
      --tgd-on-room-muted: #444;
    }

    .site-footer__rule {
      border-block-start-color: #444;
      margin-block-end: var(--space-16);
    }
  }
</style>
