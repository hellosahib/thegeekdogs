---
import { getCollection } from 'astro:content';
import { FOOTER, STUDIO_EMAIL, NAV, BUILT_ROUTES } from '../lib/copy';

/**
 * Four columns on the --void ground the closing CTA already sits on, so the page ends
 * in one continuous recessed band rather than in two stacked ones: studio identity and
 * address, Pages, Elsewhere, and the disclaimer with the copyright.
 *
 * **`links` gates the `Elsewhere` column.** The four profile links are the two founders',
 * and they belong next to the person rather than under the studio, so the column renders
 * on `/sahib/` and `/tanya/` and nowhere else. It is the one structural difference
 * between the footer on a person page and the footer everywhere else.
 *
 * **`quiet` is `/404`'s cut.** That page is a line and a link home; a nav menu underneath
 * it would be longer than the page. The studio line, the location, the address, the
 * employer note and the rights line stay, because they are the footer everywhere. The
 * employer note in particular is not discretionary: it is required wherever an employer
 * name is printed.
 */
interface Props {
  /** `/404` — drop the nav repeat. */
  quiet?: boolean;
  /** Person pages — render the `Elsewhere` column. */
  links?: boolean;
}

const { quiet = false, links = false } = Astro.props;

const people = await getCollection('people');

/** COPY.md §1's four labels, verbatim, each resolved to that person's own URL. */
const elsewhere: { label: string; href: string }[] = [];
for (const entry of FOOTER.elsewhere) {
  const person = people.find((p) => p.data.slug === entry.person);
  if (person) elsewhere.push({ label: entry.label, href: person.data.socials[entry.social] });
}

const navRepeat = NAV.filter((item) => BUILT_ROUTES.has(item.href));
const showElsewhere = links && !quiet && elsewhere.length > 0;
---

<footer class="site-footer" data-theme-anim>
  <div class="shell site-footer__grid">
    <div class="site-footer__col stack-tight">
      <p class="site-footer__studio">{FOOTER.studioLine}</p>
      <p class="small muted">{FOOTER.locationLine}</p>
      <p>
        <a class="site-footer__address mono" href={`mailto:${STUDIO_EMAIL}`}>{FOOTER.emailLabel}</a>
      </p>
    </div>

    {
      !quiet && navRepeat.length > 0 && (
        <nav class="site-footer__col" aria-labelledby="footer-pages">
          <h2 id="footer-pages" class="micro site-footer__heading">
            Pages
          </h2>
          <ul class="site-footer__links">
            {navRepeat.map((item) => (
              <li>
                <a class="site-footer__link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      showElsewhere && (
        <section class="site-footer__col" aria-labelledby="footer-elsewhere">
          <h2 id="footer-elsewhere" class="micro site-footer__heading">
            {FOOTER.elsewhereHeading}
          </h2>
          <ul class="site-footer__links">
            {elsewhere.map((item) => (
              <li>
                <a
                  class="site-footer__link"
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {item.label}
                  <span class="sr-only"> Opens a new tab.</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="site-footer__col stack-tight">
      <p class="caption muted">{FOOTER.employerNote}</p>
      <p class="caption muted mono">{FOOTER.rightsLine}</p>
    </div>
  </div>
</footer>

<style>
  /*
    The footer takes the same --void ground the closing CTA does, and the two meet with
    no seam: the page's last band is one recessed block, and the room is bookended by
    the same darkness it opened on.
  */
  .site-footer {
    background-color: var(--void);
    color: var(--ink);
    padding-block: var(--space-56);
    border-block-start: 1px solid var(--line);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: var(--space-40);
    align-items: start;
  }

  .site-footer__studio {
    font-weight: 600;
    max-inline-size: 26ch;
  }

  .site-footer__address {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    color: var(--accent);
    font-size: var(--step-small);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .site-footer__heading {
    color: var(--dim);
    font-weight: 400;
    margin-block-end: var(--space-8);
  }

  /* Every outbound link says so in its own accessible name; no icon carries it. */
  .site-footer__links {
    list-style: none;
  }

  .site-footer__link {
    display: inline-flex;
    align-items: center;
    /* 44, not 40: it is the site's floor everywhere else and there is no reason for the
       footer to be the one place a target is smaller. */
    min-block-size: 44px;
    font-size: var(--step-small);
    color: var(--dim);
    text-decoration: none;
  }

  .site-footer__link:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Paper cannot follow a link, so the two link columns do not print. The studio line,
     the location, the address and the employer note do: the note is required wherever
     an employer name is printed, and a person page prints five of them. */
  @media print {
    .site-footer__links,
    .site-footer__heading {
      display: none;
    }

    .site-footer {
      padding-block: var(--space-16) 0;
    }
  }
</style>
