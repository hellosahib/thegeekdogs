---
import { SITE_NAME, WORDMARK_ACCESSIBLE_NAME, NAV, BUILT_ROUTES, CONTACT_AFFORDANCE, STUDIO_EMAIL } from '../lib/copy';
import ThemeToggle from './ThemeToggle.astro';

/**
 * Sticky, 76px, blurred over whatever scrolls under it, with a single hairline at its
 * bottom edge.
 *
 * One component at every breakpoint: the wordmark, the nav labels, the studio's one
 * contact affordance, and the scheme toggle last. It wraps rather than collapsing — no
 * hamburger, no disclosure, no aria-expanded state.
 *
 * Only the routes that exist are rendered: a nav item pointing at a page that has not
 * been built is a broken link, and `qa:links` is right to fail on one.
 *
 * The mark beside the name is the same near-abstract dog head the agent desks carry —
 * two ears, a rounded head, a muzzle bar — at 26px. It is the studio's one piece of
 * iconography and it is drawn from the room rather than added beside it.
 */
const links = NAV.filter((item) => BUILT_ROUTES.has(item.href));
const here = Astro.url.pathname;
---

<header class="site-header" data-theme-anim>
  <div class="shell site-header__inner">
    {/* NAV has no Home entry — the wordmark is the home link — so it is the element that
        has to say so when you are on it. Without this, `/` was the one route on the site
        with no `aria-current` anywhere. */}
    <a
      class="site-header__wordmark"
      href="/"
      aria-label={WORDMARK_ACCESSIBLE_NAME}
      aria-current={here === '/' ? 'page' : undefined}
    >
      <svg width="26" height="26" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
        <path d="M7 12 2 1 14 6Z" fill="var(--accent)"></path>
        <path d="M33 12 38 1 26 6Z" fill="var(--accent)"></path>
        <path
          d="M6 13Q6 5 14 5H26Q34 5 34 13V23Q34 33 20 33Q6 33 6 23Z"
          fill="none"
          stroke="var(--ink)"
          stroke-width="2.4"></path>
        <rect x="14" y="21" width="12" height="7" rx="3.5" fill="var(--ink)"></rect>
      </svg>
      {SITE_NAME}
    </a>

    {
      links.length > 0 && (
        <nav class="site-header__nav" aria-label="Primary">
          <ul class="site-header__list">
            {links.map((item) => (
              <li>
                <a
                  class="site-header__link"
                  href={item.href}
                  aria-current={here === item.href ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <a
      class="pill pill--sm site-header__cta"
      data-cta="header"
      href={`mailto:${STUDIO_EMAIL}`}
      aria-label={CONTACT_AFFORDANCE.accessibleName}
    >
      {CONTACT_AFFORDANCE.label}
    </a>

    <div class="site-header__toggle">
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 40;
    background: var(--head);
    backdrop-filter: blur(18px) saturate(1.3);
    border-block-end: 1px solid var(--line);
  }

  /* The prefixed half, in its own block so a minifier cannot fold the pair. */
  @supports (-webkit-backdrop-filter: blur(1px)) {
    .site-header {
      -webkit-backdrop-filter: blur(18px) saturate(1.3);
    }
  }

  /*
    Where `backdrop-filter` is unsupported the header is the one surface that MUST NOT
    stay translucent: it sits over scrolling body copy, so a 72%-alpha ground with no
    blur behind it puts moving text under a static nav. It goes opaque instead.
  */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header {
      background: var(--ground);
    }
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    min-block-size: var(--header-h);
    gap: clamp(10px, 1.4vw, 22px);
    padding-block: var(--space-8);
  }

  .site-header__wordmark {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    min-block-size: 44px;
    font-weight: 600;
    font-size: clamp(17px, 1.3vw, 20px);
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--ink);
  }

  .site-header__wordmark svg {
    display: block;
    flex: 0 0 auto;
  }

  .site-header__nav {
    margin-inline-start: auto;
  }

  .site-header__list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(10px, 1.4vw, 22px);
    list-style: none;
  }

  .site-header__link {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    padding-inline: var(--space-4);
    font-size: var(--step-caption);
    text-decoration: none;
    color: var(--dim);
  }

  /* The page you are on is stated in ink, not in the accent: the accent is the signal
     for something to press, and the current page is not something to press. */
  .site-header__link[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }

  .site-header__link:hover {
    color: var(--ink);
  }

  /* With no nav to take it, the free space falls to the CTA instead. */
  .site-header__inner:not(:has(.site-header__nav)) .site-header__cta {
    margin-inline-start: auto;
  }

  .site-header__toggle {
    display: flex;
  }
</style>
