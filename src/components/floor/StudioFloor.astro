  /*
    DESIGN.md §C.3 and §C.6 — the wide box is 856 x 520 and the room draws 1:1 inside
    it. Below 1440 the box takes what is left between the section's own bleed limit and
    the slot's left edge, and the whole scene scales as one unit:

      1920 / 1440   856 x 520, 1:1        (the cap; two widths, one picture)
      1024          682 x 414, 0.797      (cols 1-8 610 + the borrowed gutter 24 + the
                                           section's left outer margin 48)
      768           704 x 428, 0.822      (the content width, stacked)

    Step-3 review item 6: the room used to render 654 x 462 at 1440 and 700 x 495 at
    1024 — smaller at the larger width, in the left half of a section with a void beside
    it. It uses its column now.
  */
  @media (min-width: 768px) {
    .scene--tall {
      display: none;
    }

    .floor__scene {
      inline-size: 100%;
      max-inline-size: 856px;
      aspect-ratio: 856 / 520;
      --fl-plate-size: 15.8px;
    }
  }

  @media (min-width: 1024px) {
    .floor__scene {
      --fl-plate-size: 16.3px;
