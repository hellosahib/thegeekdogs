---
import { roster, rosterSentence, FLOOR_INTRO, ROSTER } from '../../lib/floor';
import { CABIN_DESK_Y, FLOOR_DEFS, SHEAR } from './symbols';
import {
  BOX,
  STILL_GLOW,
  TALL_BOX,
  WIDE_BOX,
  WIDE_SLAB,
  WIDE_TRANSFORM,
  placements,
  wideOrder,
} from './plan';

/**
 * The studio floor: the semantic roster of build step 2 with DESIGN.md §C's isometric
 * scene painted underneath it.
 *
 * PLAN.md §4.1 — the interactive layer is still the same ten real HTML <button>
 * elements in the same DOM order. Step 3 changes where they sit, not what they are:
 * one CSS rule reads a --x / --y pair per button per plan and puts each one over its
 * desk. The SVG under them is decorative and carries aria-hidden="true" (COPY.md
 * §10.2), so a screen reader meets the roster once, never twice.
 *
 * DESIGN.md §C.10 — one <symbol> for the agent desk, instanced seven times; one for
 * the chair, one for a floor module, and shared desk / monitor / chair sub-symbols the
 * two bespoke cabins <use> rather than redraw. Four fills, one gradient, no <filter>,
 * no raster, no outlined text.
 *
 * DESIGN.md §C.3 / §C.7 — two plans, one geometry. The 6 x 5 desktop room and the
 * 3 x 6 portrait room are the same symbols at different <use> transforms and a
 * different viewBox, swapped by CSS. The <defs> live in their own zero-sized <svg> so
 * whichever scene is display:none, the symbols are still resolvable.
 */
const stations = await roster();
const rosterLine = await rosterSentence();
const defaultStation = stations.at(-1);
if (!defaultStation) throw new Error('The floor roster is empty; the card slot has no default.');
const defaultId = defaultStation.id;

const plan = placements();
if (plan.length !== stations.length) {
  throw new Error(
    `The floor plan has ${plan.length} stations and the roster has ${stations.length}; DESIGN.md §C.2 says ten.`,
  );
}

/* One list, zipped once: every placement carries the station it belongs to, so the two
   orders below are two orderings of the same ten objects and nothing indexes by hand. */
const scene = plan.map((p) => {
  const station = stations[p.i];
  if (!station) throw new Error(`The floor plan places station ${p.i} and the roster has none.`);
  return { ...p, station };
});

/** DESIGN.md §C.3 — far to near, so a nearer station paints over a farther one. */
const wideDrawn = wideOrder(scene);

const b = BOX;
---

<section id="studio-floor" class="section bleed room floor" tabindex="-1" data-floor>
  <div class="shell">
    <h2 class="floor__lead">{FLOOR_INTRO.leadIn}</h2>
    <p class="floor__instruction">{FLOOR_INTRO.instruction}</p>

    <div class="floor__body">
      <div class="floor__scene">
        <svg
          class="floor-defs"
          aria-hidden="true"
          focusable="false"
          width="0"
          height="0"
          set:html={FLOOR_DEFS}></svg>

        <svg
          class="scene scene--wide"
          viewBox={`0 0 ${WIDE_BOX.w} ${WIDE_BOX.h}`}
          aria-hidden="true"
          focusable="false"
        >
          <g transform={WIDE_TRANSFORM}>
            {/* Step-3 floor review, item 17: the 6 x 5 seam grid is cut. It ran the
                full room on every side, so the room's apparent footprint read larger
                than anything standing in it and the empty chair's isolation was drawn
                by ruled lines rather than by emptiness. §C.10 has the seam lines first
                in its cut order and §J now gives them a second reason to go. What is
                left is the slab and its own edge, which is the room. */}
            <polygon class="fl-slab fl-edge" points={WIDE_SLAB}></polygon>
            {
              wideDrawn.map((p) => {
                const s = p.station;
                return (
                  <g
                    class="fl-st"
                    data-scene={s.id}
                    transform={p.wideTransform}
                    style={p.i < 9 ? `--g:${STILL_GLOW[p.i]};--d:${p.i}` : undefined}
                  >
                    {p.shape === 'cabin' && (
                      <use
                        href={p.i === 0 ? '#fl-cabin-s' : '#fl-cabin-t'}
                        x={b.cabin.x}
                        y={b.cabin.y}
                        width={b.cabin.w}
                        height={b.cabin.h}
                      />
                    )}
                    {p.shape === 'agent' && (
                      <use href="#fl-agent" x={b.agent.x} y={b.agent.y} width={b.agent.w} height={b.agent.h} />
                    )}
                    {p.shape === 'chair' && (
                      <>
                        <path class="fl-cone" d="M0 0 64 32 0 64-64 32Z" />
                        <use href="#fl-seat" x={b.seat.x} y={b.seat.y} width={b.seat.w} height={b.seat.h} />
                        <path class="fl-cone" d="M0-26 44-4 0 18-44-4Z" /><path class="fl-cone" d="M-9-56 9-56 44-4-44-4Z" />
                      </>
                    )}
                    {p.i < 9 && (
                      <g class="fl-lit-up">
                        <rect
                          class="fl-glow"
                          x="5"
                          y={p.shape === 'cabin' ? CABIN_DESK_Y - 37 : -37}
                          width="28"
                          height="24"
                          transform={SHEAR}
                        />
                      </g>
                    )}
                  </g>
                );
              })
            }
            {/* DESIGN.md §C.3 and §C.4 — every nameplate paints last, so a nearer
                cabin's wall can never cross the plate of the one behind it.

                One room, one nameplate treatment, one baseline, at every width. The
                wall-mounted, skewed cabin door plate is REMOVED — it is §J's
                pre-committed cut for `/` and §C.4 now forbids it in terms: it was the
                only skewed type on the site, the only nameplate treatment that changed
                between breakpoints, the least legible text on the page, and at >= 1024
                it put "Sahib Singh" inside Tanya's button. Both cabin plates are now
                set horizontally on the near half of their own cabin floor, at §C.3's
                own coordinates: (396, 204) for Sahib and (268, 268) for Tanya in the
                856 x 520 box, which is local (0, 100) on each cabin's own node.

                An agent's plate sits on the near half of its own module rather than
                floating above the desk. Measured reason, and §C.3 now carries it: on
                the checkerboard a desk and the desk behind-left of it share a screen x
                and are only 64 units apart in y, so a plate above the desk lands
                squarely on the desk behind it. y is the module's own midline, which
                with a central baseline puts the plate box's bottom 8 units clear of the
                next button's leading edge — §C.3's own number. The chair's plate takes
                its module's near vertex, because nothing stands in front of it. */}
            <g class="fl-plates">
              {
                scene.map((p) => {
                  const s = p.station;
                  return (
                    <text
                      class={`fl-plate${p.shape === 'cabin' ? '' : ' fl-plate--agent'}`}
                      data-plate={s.id}
                      transform={p.wideTransform}
                      x="0"
                      y={p.shape === 'cabin' ? 100 : p.shape === 'chair' ? 64 : 32}
                      text-anchor="middle"
                    >
                      {s.label}
                    </text>
                  );
                })
              }
            </g>
          </g>
        </svg>

        <svg
          class="scene scene--tall"
          viewBox={`0 0 ${TALL_BOX.w} ${TALL_BOX.h}`}
          aria-hidden="true"
          focusable="false"
        >
          {
            scene.map((p) => {
              const s = p.station;
              return (
                <g
                  class="fl-st"
                  data-scene={s.id}
                  transform={p.tallTransform}
                  style={p.i < 9 ? `--g:${STILL_GLOW[p.i]};--d:${p.i}` : undefined}
                >
                  {p.shape !== 'cabin' && (
                    <use href="#fl-mod" x="-64" y="0" width="128" height="64" />
                  )}
                  {p.shape === 'cabin' && (
                    <use
                      href={p.i === 0 ? '#fl-cabin-s' : '#fl-cabin-t'}
                      x={b.cabin.x}
                      y={b.cabin.y}
                      width={b.cabin.w}
                      height={b.cabin.h}
                    />
                  )}
                  {p.shape === 'agent' && (
                    <use href="#fl-agent" x={b.agent.x} y={b.agent.y} width={b.agent.w} height={b.agent.h} />
                  )}
                  {p.shape === 'chair' && (
                    <>
                      <path class="fl-cone" d="M0 0 64 32 0 64-64 32Z" />
                      <use href="#fl-seat" x={b.seat.x} y={b.seat.y} width={b.seat.w} height={b.seat.h} />
                      <path class="fl-cone" d="M0-26 44-4 0 18-44-4Z" /><path class="fl-cone" d="M-9-56 9-56 44-4-44-4Z" />
                    </>
                  )}
                  {p.i < 9 && (
                    <g class="fl-lit-up">
                      <rect
                        class="fl-glow"
                        x="5"
                        y={p.shape === 'cabin' ? CABIN_DESK_Y - 37 : -37}
                        width="28"
                        height="24"
                        transform={SHEAR}
                      />
                    </g>
                  )}
                </g>
              );
            })
          }
          {
            scene.map((p) => {
              const s = p.station;
              return (
                <text
                  class={`fl-plate${p.shape === 'cabin' ? '' : ' fl-plate--agent'}`}
                  data-plate={s.id}
                  x={p.tallPlateX}
                  y={p.tallPlateY}
                  text-anchor="middle"
                >
                  {s.label}
                </text>
              );
            })
          }
        </svg>

        <ul class="roster">
          {
            scene.map((p) => (
              <li class="roster__item">
                <button
                  type="button"
                  class="station"
                  data-station={p.station.id}
                  data-kind={p.station.kind}
                  data-selected={p.station.id === defaultId ? 'true' : undefined}
                  aria-label={p.station.accessibleName}
                  style={`--xw:${p.wide.x};--yw:${p.wide.y};--xt:${p.tall.x};--yt:${p.tall.y}`}
                >
                  <span class="sr-only">{p.station.label}</span>
                </button>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="floor__slot" data-floor-slot>
        {
          stations.map((station) => (
            <article
              class="station-card"
              data-card={station.id}
              hidden={station.id === defaultId ? undefined : true}
            >
              <h3 class="station-card__name">{station.label}</h3>
              {station.lead && <p class="station-card__lead">{station.lead}</p>}
              <p class="station-card__body">{station.body}</p>
              {
                station.gateBlock && (
                  <div class="station-card__gate">
                    <p class="station-card__gate-label">{station.gateBlock.label}</p>
                    <p class="station-card__gate-name">{station.gateBlock.value}</p>
                  </div>
                )
              }
            </article>
          ))
        }
      </div>
      <span class="sr-only" data-floor-announce aria-live="polite"></span>
    </div>

    <p class="floor__roster-label micro">{ROSTER.label}</p>
    <p class="floor__roster small">{rosterLine}</p>
  </div>
</section>

<script>
  /*
    PLAN.md §4.2, §4.3 — one "open card" path, reached by pointer, by focus and by tap.
    The visibility mechanism is the native `hidden` attribute, so the nine cards that
    are not showing leave the accessibility tree entirely; `data-selected` on the button
    and `data-on` on its group in the scene are styling hooks only.

    DESIGN.md §C.9 — the slot swaps instantly. No fade, no slide, nothing to animate.

    DESIGN.md §H.3 — "Lights on" is the page's one orchestrated moment. It is a set of
    CSS animations; this script only decides *whether* and *when* they run, because
    §H.3 requires the h1 to have painted first and §H.4 requires the moment to be gone
    entirely under reduced motion. Arming happens at module-execution time, before the
    section can paint, so the room is never seen lit and then switched off; firing
    happens on the frame after `load`, which is provably after first paint.
  */
  const floor = document.querySelector<HTMLElement>('[data-floor]');
  const slot = floor?.querySelector<HTMLElement>('[data-floor-slot]');
  const announce = floor?.querySelector<HTMLElement>('[data-floor-announce]');

  if (floor && slot) {
    const cards = new Map<string, HTMLElement>();
    for (const card of slot.querySelectorAll<HTMLElement>('[data-card]')) {
      cards.set(card.dataset.card ?? '', card);
    }
    const buttons = Array.from(floor.querySelectorAll<HTMLElement>('[data-station]'));
    const groups = Array.from(floor.querySelectorAll<SVGElement>('[data-scene]'));

    let open = '';
    for (const [id, card] of cards) {
      if (!card.hidden) open = id;
    }
    const mark = (id: string): void => {
      for (const button of buttons) {
        if (button.dataset.station === id) button.dataset.selected = 'true';
        else delete button.dataset.selected;
      }
      for (const group of groups) {
        if (group.getAttribute('data-scene') === id) group.setAttribute('data-on', '');
        else group.removeAttribute('data-on');
      }
    };
    mark(open);

    const show = (id: string): void => {
      if (id === open || !cards.has(id)) return;
      cards.get(open)?.setAttribute('hidden', '');
      cards.get(id)?.removeAttribute('hidden');
      mark(id);
      open = id;
    };

    const from = (target: EventTarget | null): string | undefined =>
      (target as Element | null)?.closest<HTMLElement>('[data-station]')?.dataset.station;

    /*
      REVIEWS.md 2026-09-05, Perf & A11y ruling 2. Focus and hover swap the slot
      SILENTLY: the button that just took focus has already spoken the role and the
      gate that checks it (COPY.md §10.2), and a live region here read a whole card
      over the top of the next Tab's own announcement, ten times in a row.

      Activation — click, and therefore Enter and Space on a <button> — is the one path
      that announces, and it announces whether or not the content changed, because
      pressing Enter on the station you are already focused on is exactly the "read me
      this card" gesture. The region is in the DOM from first paint, so it is registered
      before it is ever written to. Nothing new is spoken: the text is the card's own.
    */
    const say = (id: string): void => {
      const card = cards.get(id);
      if (!announce || !card) return;
      announce.textContent = (card.textContent ?? '').replace(/\s+/g, ' ').trim();
    };

    for (const type of ['pointerover', 'focusin'] as const) {
      floor.addEventListener(type, (event: Event) => {
        const id = from(event.target);
        if (id) show(id);
      });
    }

    floor.addEventListener('click', (event: Event) => {
      const id = from(event.target);
      if (!id) return;
      show(id);
      say(id);
    });

    /* DESIGN.md §H.4 — under `reduce` the moment is not shortened, it is absent, and
       the still frame of §C.9 is what the unconditional CSS already renders. */
    const wantsMotion = window.matchMedia('(prefers-reduced-motion: no-preference)');
    if (wantsMotion.matches) {
      floor.dataset.lights = 'armed';
      /* Interruptible: a visitor who reaches for a desk gets the finished room, not a
         sequence that has to play out first. */
      const settle = (): void => {
        delete floor.dataset.lights;
      };
      const fire = (): void => {
        requestAnimationFrame(() => {
          if (floor.dataset.lights !== 'armed') return;
          floor.dataset.lights = 'on';
          /* §H.3's own total: last glow ends at 1200ms, 400ms hold, 900ms lamp. */
          window.setTimeout(settle, 2500);
        });
      };
      floor.addEventListener('pointerdown', settle, { once: true });
      floor.addEventListener('focusin', settle, { once: true });
      if (document.readyState === 'complete') fire();
      else window.addEventListener('load', fire, { once: true });
    }
  }
</script>

<style>
  /* PLAN.md §4.5 — the section reserves its height so the headline above it paints
     first and nothing shifts when the section is laid out. */
  .floor {
    content-visibility: auto;
    contain-intrinsic-size: auto 1180px;
  }

  .floor__lead {
    max-inline-size: 20ch;
  }

  .floor__instruction {
    margin-block-start: var(--space-16);
    color: var(--tgd-on-room-muted);
  }

  .floor__body {
    margin-block-start: var(--space-32);
    display: grid;
    gap: var(--space-24);
  }

  /*
    DESIGN.md §C.1 — four fills in the whole scene, all derived from the six tokens,
    plus one gradient for the lamp cone. Three of the four follow --floor automatically
    because they are alphas over it; only the shadow is an absolute value, and it takes
    §C.1's second hex in dark so it keeps the same relationship to the deeper ground.
  */
  .floor__scene {
    /* §C.3 — the portrait plan renders 1:1, so its plates are set at the size they are
       read at. The wide plan overrides this per breakpoint, below. */
    --fl-plate-size: 13px;

    --fl-ground: var(--tgd-room);
    --fl-lit: rgba(232, 237, 233, 0.22);
    --fl-shadow: #0a1e21;
    --fl-glow: var(--chalk);
    /* §C.8 — a selected or focused desk's top surface lifts to --chalk @ 52% (round 12). */
    --fl-desk-top: var(--fl-lit);

    position: relative;
    margin-inline: auto;
  }

  :global([data-theme='dark']) .floor__scene {
    --fl-shadow: #051113;
  }

  .floor-defs {
    position: absolute;
    inline-size: 0;
    block-size: 0;
    overflow: hidden;
  }

  .scene {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    /* §C.3 gives the box 76 units of margin for the plates that overhang their module,
       and §C.7's widest portrait plate is a little wider than its own 101.3 column. An
       outermost <svg> clips to its viewport by default, which cut `Release Watcher` at
       360; the page's own outer margin is where that overhang goes. */
    overflow: visible;
  }

  /*
    Every rule below is :global on purpose, and it is a bug fix rather than a style.
    The scene's <defs> are shared with the build-time OG card, so they are a string
    injected with `set:html` — and Astro cannot add its scope attribute to markup it did
    not compile. Scoped, `.fl-lit[data-astro-cid-…]` matched nothing inside a <symbol>,
    every fill in the room fell back to the initial `black`, and the whole scene rendered
    as one flat silhouette. These class names exist nowhere else on the site and are all
    prefixed `fl-`, so global is the honest scope for them: they belong to the drawing,
    not to this component's box.
  */
  :global(.fl-slab) {
    fill: var(--fl-ground);
  }

  /* Step-3 review item 17 — with the seam grid cut, the slab's own edge is the room. */
  :global(.fl-edge) {
    stroke: var(--fl-lit);
    stroke-width: 1;
  }

  :global(.fl-lit) {
    fill: var(--fl-lit);
  }

  :global(.fl-shadow) {
    fill: var(--fl-shadow);
  }

  /* A cabin wall is the shadow fill with the lit fill as a one-unit edge. The stroke is
     not a fifth value and not a segment: it is what separates two abutting cabins, and
     the lamp rule does not reach it because both values are already in §C.1's four. */
  :global(.fl-wall) {
    fill: var(--fl-shadow);
    stroke: var(--fl-lit);
    stroke-width: 1;
  }

  /*
    The desk's top face, and §C.8's second indicator on it. The edge is `transparent` at
    rest and `--chalk` on the selected station; it is a custom property rather than a
    descendant selector because `.fl-top` lives inside a `<use>`'s shadow tree, which a
    selector cannot reach and an inherited property can. Same mechanism as the fill above.
  */
  :global(.fl-top) {
    fill: var(--fl-desk-top);
    stroke: var(--fl-desk-edge, transparent);
    stroke-width: 1;
  }

  :global(.fl-glow) {
    fill: var(--fl-glow);
    opacity: var(--g, 0.7);
  }

  :global(.fl-seam) {
    fill: none;
    stroke: var(--fl-lit);
    stroke-width: 1;
  }

  :global(.fl-mark) {
    fill: none;
    stroke: var(--fl-glow);
    stroke-width: 1.5;
    opacity: 0.55;
  }

  :global(.fl-mark-fill) {
    fill: var(--fl-glow);
    opacity: 0.4;
  }

  /* §C.1's one gradient, on three marks: the pool the lamp throws on the floor, the
     wash it throws on the desk top, and the cone of light between them. §C.3 mechanism
     2 asks for light *falling on* the chair, which one wedge drawn over the object was
     not delivering (step-3 review, item 9). */
  :global(.fl-cone) {
    fill: url(#fl-cone);
  }

  :global(.fl-cone-a) {
    stop-color: var(--lamp);
    stop-opacity: 0.5;
  }

  :global(.fl-cone-b) {
    stop-color: var(--lamp);
    stop-opacity: 0.06;
  }

  /*
    DESIGN.md §C.4 — nameplates are real <text>, never outlined paths. One treatment,
    one baseline, at every width: the cabin plate is Anek 600 one step up, an agent's is
    Instrument 600 at micro. The floor-coloured stroke behind the glyphs keeps a plate
    legible where it passes the desk in front of it.

    Step-3 review item 13 — §B.4's smallest step is micro at 13px and there is nothing
    below it, so NO PLATE RENDERS BELOW 13 CSS px. The scene scales and its text scales
    with it, so §C.3 expresses the plate's size in scene units per breakpoint to land on
    the same rendered size: 13 units at 1:1, 16.3 where the box is 682 of 856 (1024) and
    15.8 where it is 704 of 856 (768). The cabin plate takes the step above at 15px
    rendered, which is the same ratio at every one of them.
  */
  .fl-plate {
    fill: var(--tgd-on-room);
    font-family: var(--tgd-font-display);
    font-weight: var(--wght-display);
    font-size: calc(var(--fl-plate-size) * 15 / 13);
    paint-order: stroke;
    stroke: var(--fl-ground);
    stroke-width: 3px;
    stroke-linejoin: round;
    dominant-baseline: central;
  }

  .fl-plate--agent {
    fill: var(--tgd-on-room-muted);
    font-family: var(--tgd-font-body);
    font-weight: 600;
    font-size: var(--fl-plate-size);
  }

  /*
    DESIGN.md §C.8 round 12 — the selected fill is --chalk @ 52%, up from 34%. Review
    item H9: 34% was built exactly and could not be seen. Pixel-differenced under
    `reduce` so only the state differs, 34% moved 13.4% of the desk's pixels at a
    maximum channel delta of 27 at 1440 and 3.0% at 360, and at 1:1 the two frames were
    indistinguishable. The amplitude was the spec's and it was too small. 52% roughly
    doubles the step over §C.1's unlit desk top (--chalk @ 22%) and stays below the
    monitor glow's 55-85%, so the brightest thing in the room is still a screen and not
    a table.
  */
  .fl-st[data-on] {
    --fl-desk-top: rgba(232, 237, 233, 0.52);
    /*
      **§C.8's priced fallback, taken on measurement.** The section states the acceptance
      test — the same pixel-difference method under `reduce`, at 360 and 1440 in both
      schemes, needing ">= 30% of the desk's pixels changed at a maximum channel delta
      >= 60" — and names what to do if 52% alone does not reach it: "a 1px `--chalk`
      top-edge inset on the selected station, a mark the room already draws elsewhere",
      taken "only on measurement, never in addition on preference".

      Measured at 52% alone (scripts/evidence-rund.mjs): max channel delta **67 light, 69
      dark** — past the 60 — but **24.6% of the station's pixels at 1440 and 15.5% at 360**,
      which is short of the 30. So the fallback is taken, and it is taken because the
      measurement said so. The room already draws exactly this stroke twice: the slab's own
      edge (`.fl-edge`) and the cabin walls both take a 1-unit `--fl-lit` stroke, so this
      is the existing vocabulary at a higher value rather than a new mark.
    */
    --fl-desk-edge: var(--chalk);
  }

  /*
    DESIGN.md §C.9 — the default, unconditional state is the still frame: nine glows at
    nine different static opacities, the lamp cone at full. There is no JS toggle to get
    wrong, because the loop below is additive and nothing else is.
  */
  @media (prefers-reduced-motion: no-preference) {
    /* DESIGN.md §C.5 — one loop, one property, 4800ms, symmetric easing, each station
       offset by index x 533ms so nine stations never share a phase. */
    .fl-glow {
      animation: fl-idle var(--loop-floor) var(--ease-idle) calc(var(--d, 0) * -533ms) infinite;
    }

    /* DESIGN.md §H.3 — "Lights on". The glows come up in DOM order at 70ms stagger over
       --dur-4 each; then 400ms of nothing; then the lamp cone alone over 900ms. The
       fade is on a wrapper, so the idle loop underneath is never interrupted and the
       room never jumps when the moment ends. */
    .floor[data-lights='armed'] .fl-lit-up,
    .floor[data-lights='armed'] .fl-cone {
      opacity: 0;
    }

    .floor[data-lights='on'] .fl-lit-up {
      animation: fl-up var(--dur-4) var(--ease-out) calc(var(--d, 0) * 70ms) both;
    }

    /*
      Step-3 review item 16 — the cone was measured coming up in ~620ms against §H.3's
      900. The declaration always said 900ms; what was 620 was the *shape*. --ease-out
      is cubic-bezier(.16, 1, .3, 1), which is at 90% of its travel inside 330ms, so the
      one deliberate slow moment on the page was over before its duration was. The lamp
      takes --ease-inout instead — §H.1's symmetric curve, half its travel at 450ms —
      which is the only one of the four tokens whose 900ms is felt as 900ms. The glows
      keep --ease-out: they are arrivals, and the review passed their timing.
    */
    .floor[data-lights='on'] .fl-cone {
      animation: fl-up 900ms var(--ease-inout) 1600ms both;
    }
  }

  @keyframes fl-idle {
    0%,
    100% {
      opacity: 0.55;
    }
    50% {
      opacity: 0.85;
    }
  }

  @keyframes fl-up {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /*
    DESIGN.md §C.10 — no per-desk bespoke CSS. One rule places every station; the only
    per-station values are the two coordinate pairs on the button itself, and the only
    per-class values are the three footprints below.
  */
  .roster {
