  /* DESIGN.md §C.3 — 112 x 56, 128 x 136 and 128 x 88 of the 856 x 520 box. */
  .station[data-kind='agent'] {
    --w: 13.0841%;
    --h: 10.7692%;
  }

  .station[data-kind='human'] {
    --w: 14.9533%;
    --h: 26.1538%;
