---
import { roster, rosterSentence, FLOOR_INTRO, ROSTER } from '../../lib/floor';
import { FLOOR_DEFS, WALL_SKEW } from './symbols';
import {
  BOX,
  STILL_GLOW,
  TALL_BOX,
  WIDE_BOX,
  WIDE_SLAB,
  WIDE_TRANSFORM,
  pipelinePath,
  placements,
  wideOrder,
} from './plan';

/**
 * The studio floor: the semantic roster with the isometric scene painted underneath it.
 *
 * The interactive layer is ten real HTML <button> elements in roster order. One CSS rule
 * reads a --x / --y pair per button per plan and puts each one over its own station. The
 * SVG under them is decorative and carries aria-hidden="true", so a screen reader meets
 * the roster once, never twice.
 *
 * Two plans, one geometry. The 6 x 5 desktop room and the 3 x 6 portrait room are the
 * same symbols at different <use> transforms and a different viewBox, swapped by CSS.
 * The portrait plan is what keeps the nameplates legible at 360: the wide scene at that
 * width would set a 12px plate at roughly 4.5px.
 *
 * The redesign changes the room's MATERIALS and its LIGHT, not its plan. Every
 * coordinate below came out of `plan.ts` before and comes out of it now.
 */
const stations = await roster();
const rosterLine = await rosterSentence();
const defaultStation = stations.at(-1);
if (!defaultStation) throw new Error('The floor roster is empty; the card slot has no default.');
/*
  The default selection is the empty chair, and that is not an arbitrary choice of
  first item: the chair is the page's argument, so it is what a visitor lands on. It is
  server-rendered, so the panel is right before any JavaScript runs and stays right if
  none ever does.
*/
const defaultId = defaultStation.id;

const plan = placements();
if (plan.length !== stations.length) {
  throw new Error(
    `The floor plan has ${plan.length} stations and the roster has ${stations.length}; the room is ten.`,
  );
}

/* One list, zipped once: every placement carries the station it belongs to, so the two
   orders below are two orderings of the same ten objects and nothing indexes by hand. */
const scene = plan.map((p) => {
  const station = stations[p.i];
  if (!station) throw new Error(`The floor plan places station ${p.i} and the roster has none.`);
  /*
    Roster indices 2 to 8 are the seven agent desks in pipeline order, so a desk's own
    number is its index less the two cabins. It is derived rather than stored because
    the number a card prints and the number a plan places have to be the same number.
  */
  const deskNo = p.shape === 'agent' ? p.i - 1 : 0;
  return { ...p, station, deskNo };
});

/** Far to near, so a nearer station paints over a farther one. */
const wideDrawn = wideOrder(scene);

/**
 * The panel's kind label. It is generated rather than written into the data layer
 * because it is a statement about the plan — which desk, which cabin — and the plan is
 * what changes when the room does.
 */
function kindLabel(kind: string, deskNo: number): string {
  if (kind === 'human') return 'Human · cabin';
  if (kind === 'chair') return 'The empty chair';
  return `Agent · desk ${deskNo}`;
}

/**
 * The seven role marks: one small lamp-coloured mark above each agent's head, all
 * different, so a desk is identifiable at a glance before its nameplate is legible.
 * Dot, two dots, bar, ring, diamond, dash, hollow ring — in pipeline order.
 */
/*
  The mark rides ABOVE the monitor, not just above the head, and the 48 is a clearance
  rather than a look. The checkerboard puts the station in front of this one exactly 64
  units down-screen, and that station's nameplate sits 32 units below ITS node — so a
  mark at -32 lands squarely inside the plate box of the desk behind it, which is where
  `qa:contrast` found seven lamp-coloured marks sitting under seven nameplates at 1.45:1.
  At -48 no station's mark shares a row with any station's plate.
*/
const MARK_Y = -48;
const ROLE_MARKS = [
  `<circle cx="-22" cy="${MARK_Y}" r="2.4"/>`,
  `<circle cx="-27" cy="${MARK_Y}" r="2.2"/><circle cx="-17" cy="${MARK_Y}" r="2.2"/>`,
  `<rect x="-29" y="${MARK_Y - 1.5}" width="14" height="3" rx="1.5"/>`,
  `<circle cx="-22" cy="${MARK_Y}" r="3.4" fill="none" stroke="currentColor" stroke-width="1.6"/>`,
  `<path d="M-22 ${MARK_Y - 4.4}-17.6 ${MARK_Y}-22 ${MARK_Y + 4.4}-26.4 ${MARK_Y}Z"/>`,
  `<rect x="-29" y="${MARK_Y - 1.3}" width="6" height="2.6" rx="1.3"/><rect x="-21" y="${MARK_Y - 1.3}" width="6" height="2.6" rx="1.3"/>`,
  `<circle cx="-22" cy="${MARK_Y}" r="4.2" fill="none" stroke="currentColor" stroke-width="1.2"/>`,
];

/** The heads alternate so that no two adjacent desks carry the same form. */
const headFor = (deskNo: number): string => (deskNo % 2 === 1 ? '#fl-agent' : '#fl-agent-f');

const handoff = pipelinePath();
const b = BOX;
---

<section id="studio-floor" class="section room floor" tabindex="-1" data-floor data-theme-anim>
  <div class="shell">
    <div class="floor__head" data-rv>
      <div>
        <p class="eyebrow floor__eyebrow">The floor</p>
        <h2 class="floor__lead">{FLOOR_INTRO.leadIn}</h2>
      </div>
      <p class="floor__instruction">{FLOOR_INTRO.instruction}</p>
    </div>

    <div class="floor__body">
      <div class="floor__scene" data-scene-wrap>
        <svg
          class="floor-defs"
          aria-hidden="true"
          focusable="false"
          width="0"
          height="0"
          set:html={FLOOR_DEFS}></svg>

        <svg
          class="scene scene--wide"
          viewBox={`0 0 ${WIDE_BOX.w} ${WIDE_BOX.h}`}
          aria-hidden="true"
          focusable="false"
        >
          <g transform={WIDE_TRANSFORM}>
            <polygon class="fl-slab" points={WIDE_SLAB}></polygon>
            {/* The slab's own accent bloom: a wide, very low-alpha stroke sitting on
                the room's edge, which is what stops the floor ending on a hard line
                against the --void band it is cut into. */}
            <polygon class="fl-bloom" points={WIDE_SLAB}></polygon>

            {/* The handoff. Work moves desk to desk down the pipeline and stops at the
                chair, and one dashed line says it before any card is opened. The dot
                rides the same path via `offset-path`, so the line and the travel are
                one geometry rather than two that have to be kept in step. */}
            <path class="fl-pipe" d={handoff}></path>
            <circle class="fl-handoff" r="4" style={`offset-path:path('${handoff}')`}></circle>

            {
              wideDrawn.map((p) => {
                const s = p.station;
                return (
                  <g
                    class="fl-st"
                    data-scene={s.id}
                    transform={p.wideTransform}
                    style={p.i < 9 ? `--g:${STILL_GLOW[p.i]};--d:${p.i}` : undefined}
                  >
                    {p.shape === 'cabin' && (
                      <use
                        href={p.i === 0 ? '#fl-cabin-s' : '#fl-cabin-t'}
                        x={b.cabin.x}
                        y={b.cabin.y}
                        width={b.cabin.w}
                        height={b.cabin.h}
                      />
                    )}
                    {p.shape === 'agent' && (
                      <>
                        <use
                          href={headFor(p.deskNo)}
                          x={b.agent.x}
                          y={b.agent.y}
                          width={b.agent.w}
                          height={b.agent.h}
                        />
                        <g class="fl-role" set:html={ROLE_MARKS[p.deskNo - 1]} />
                      </>
                    )}
                    {p.shape === 'chair' && (
                      <>
                        {/* Three cone volumes, not one: the floor pool, the mid
                            volume and the shaft from the shade. A single triangle
                            reads as a shape; three stacked ones read as light. */}
                        <path class="fl-cone" d="M0 0 64 32 0 64-64 32Z" />
                        <use href="#fl-seat" x={b.seat.x} y={b.seat.y} width={b.seat.w} height={b.seat.h} />
                        <path class="fl-cone" d="M0-26 44-4 0 18-44-4Z" /><path class="fl-cone" d="M-9-56 9-56 44-4-44-4Z" />
                      </>
                    )}
                  </g>
                );
              })
            }

            {/*
              Nameplates paint last, so a nearer cabin's wall can never cross the plate
              of the one behind it.

              The two cabin names are LETTERED ON THE CABIN'S OWN LEFT WALL rather than
              floated below it: `matrix(1 -0.5 0 1 0 0)` is the isometric skew for a
              left-facing plane, so type drawn inside it reads as painted on the wall.

              The anchor is -66, -32 and the handoff's is -66, -19. A left wall faces
              down-screen-left, which is exactly where the other cabin stands, and the
              skew stretches a plate's box by half its own width in y — so at -19 Sahib's
              name reached into Tanya's button and `check-floor-pointer` failed it as a
              nameplate inside another station's target, at every width. 13 units up puts
              it back inside its own wall and out of her box.

              The agents' plates stay horizontal on the near half of their own module,
              because a desk and the desk behind-left of it share a screen x and a plate
              above the desk would land on the one behind it.
            */}
            <g class="fl-plates">
              {
                scene.map((p) => {
                  const s = p.station;
                  if (p.shape === 'cabin') {
                    return (
                      <g transform={`${p.wideTransform} ${WALL_SKEW}`}>
                        <text class="fl-plate fl-plate--wall" data-plate={s.id} x="-66" y="-32" text-anchor="middle">
                          {s.label}
                        </text>
                      </g>
                    );
                  }
                  return (
                    <text
                      class={`fl-plate${p.shape === 'chair' ? ' fl-plate--chair' : ' fl-plate--agent'}`}
                      data-plate={s.id}
                      transform={p.wideTransform}
                      x="0"
                      y={p.shape === 'chair' ? 84 : 32}
                      text-anchor="middle"
                    >
                      {s.label}
                    </text>
                  );
                })
              }
            </g>
          </g>
        </svg>

        <svg
          class="scene scene--tall"
          viewBox={`0 0 ${TALL_BOX.w} ${TALL_BOX.h}`}
          aria-hidden="true"
          focusable="false"
        >
          {
            scene.map((p) => {
              const s = p.station;
              return (
                <g
                  class="fl-st"
                  data-scene={s.id}
                  transform={p.tallTransform}
                  style={p.i < 9 ? `--g:${STILL_GLOW[p.i]};--d:${p.i}` : undefined}
                >
                  {p.shape !== 'cabin' && (
                    <use href="#fl-mod" x="-64" y="0" width="128" height="64" />
                  )}
                  {p.shape === 'cabin' && (
                    <use
                      href={p.i === 0 ? '#fl-cabin-s' : '#fl-cabin-t'}
                      x={b.cabin.x}
                      y={b.cabin.y}
                      width={b.cabin.w}
                      height={b.cabin.h}
                    />
                  )}
                  {p.shape === 'agent' && (
                    <use
                      href={headFor(p.deskNo)}
                      x={b.agent.x}
                      y={b.agent.y}
                      width={b.agent.w}
                      height={b.agent.h}
                    />
                  )}
                  {p.shape === 'chair' && (
                    <>
                      <path class="fl-cone" d="M0 0 64 32 0 64-64 32Z" />
                      <use href="#fl-seat" x={b.seat.x} y={b.seat.y} width={b.seat.w} height={b.seat.h} />
                      <path class="fl-cone" d="M0-26 44-4 0 18-44-4Z" /><path class="fl-cone" d="M-9-56 9-56 44-4-44-4Z" />
                    </>
                  )}
                </g>
              );
            })
          }
          {
            scene.map((p) => {
              const s = p.station;
              return (
                <text
                  class={`fl-plate${p.shape === 'cabin' ? '' : ' fl-plate--agent'}`}
                  data-plate={s.id}
                  x={p.tallPlateX}
                  y={p.tallPlateY}
                  text-anchor="middle"
                >
                  {s.label}
                </text>
              );
            })
          }
        </svg>

        {/*
          The room appears lit from wherever the pointer is. It is a decorative layer
          with no hit area of its own, so it can sit over the whole scene without taking
          a single click off the ten buttons underneath it.
        */}
        <span class="floor__lit" aria-hidden="true"></span>

        <ul class="roster">
          {
            scene.map((p) => (
              <li class="roster__item">
                <button
                  type="button"
                  class="station"
                  data-station={p.station.id}
                  data-kind={p.station.kind}
                  data-selected={p.station.id === defaultId ? 'true' : undefined}
                  aria-label={p.station.accessibleName}
                  style={`--xw:${p.wide.x};--yw:${p.wide.y};--ww:${p.wide.w};--hw:${p.wide.h};--xt:${p.tall.x};--yt:${p.tall.y};--wt:${p.tall.w};--ht:${p.tall.h}`}
                >
                  <span class="sr-only">{p.station.label}</span>
                </button>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="floor__slot glass" data-floor-slot>
        {
          scene.map((p) => (
            <article
              class="station-card"
              data-card={p.station.id}
              hidden={p.station.id === defaultId ? undefined : true}
            >
              <p class="station-card__kind micro">{kindLabel(p.station.kind, p.deskNo)}</p>
              <h3 class="station-card__name">{p.station.label}</h3>
              {p.station.lead && <p class="station-card__lead">{p.station.lead}</p>}
              <p class="station-card__body">{p.station.body}</p>
              {
                p.station.gateBlock && (
                  <div class="station-card__gate">
                    <p class="station-card__gate-label micro">{p.station.gateBlock.label}</p>
                    <p class="station-card__gate-name">{p.station.gateBlock.value}</p>
                  </div>
                )
              }
            </article>
          ))
        }
      </div>
      <span class="sr-only" data-floor-announce aria-live="polite"></span>
    </div>

    <p class="floor__roster-label micro">{ROSTER.label}</p>
    <p class="floor__roster small muted">{rosterLine}</p>
  </div>
</section>

<script>
  /*
    One "open card" path, reached by pointer, by focus and by tap. The visibility
    mechanism is the native `hidden` attribute, so the nine cards that are not showing
    leave the accessibility tree entirely; `data-selected` on the button and `data-on` on
    its group in the scene are styling hooks only.

    The slot swaps instantly. No fade, no slide, nothing to animate — the panel is the
    answer to a pointer that is already moving.
  */
  const floor = document.querySelector<HTMLElement>('[data-floor]');
  const slot = floor?.querySelector<HTMLElement>('[data-floor-slot]');
  const announce = floor?.querySelector<HTMLElement>('[data-floor-announce]');
  const wrap = floor?.querySelector<HTMLElement>('[data-scene-wrap]');

  if (floor && slot) {
    const cards = new Map<string, HTMLElement>();
    for (const card of slot.querySelectorAll<HTMLElement>('[data-card]')) {
      cards.set(card.dataset.card ?? '', card);
    }
    const buttons = Array.from(floor.querySelectorAll<HTMLElement>('[data-station]'));
    const groups = Array.from(floor.querySelectorAll<SVGElement>('[data-scene]'));

    let open = '';
    for (const [id, card] of cards) {
      if (!card.hidden) open = id;
    }
    const mark = (id: string): void => {
      for (const button of buttons) {
        if (button.dataset.station === id) button.dataset.selected = 'true';
        else delete button.dataset.selected;
      }
      for (const group of groups) {
        if (group.getAttribute('data-scene') === id) group.setAttribute('data-on', '');
        else group.removeAttribute('data-on');
      }
    };
    mark(open);

    const show = (id: string): void => {
      if (id === open || !cards.has(id)) return;
      cards.get(open)?.setAttribute('hidden', '');
      cards.get(id)?.removeAttribute('hidden');
      mark(id);
      open = id;
    };

    const from = (target: EventTarget | null): string | undefined =>
      (target as Element | null)?.closest<HTMLElement>('[data-station]')?.dataset.station;

    /*
      Focus and hover swap the slot SILENTLY: the button that just took focus has already
      spoken the role and the gate that checks it, and a live region here would read a
      whole card over the top of the next Tab's own announcement, ten times in a row.

      Activation — click, and therefore Enter and Space on a <button> — is the one path
      that announces, and it announces whether or not the content changed, because
      pressing Enter on the station you are already focused on is exactly the "read me
      this card" gesture.
    */
    const say = (id: string): void => {
      const card = cards.get(id);
      if (!announce || !card) return;
      announce.textContent = (card.textContent ?? '').replace(/\s+/g, ' ').trim();
    };

    for (const type of ['pointerover', 'focusin'] as const) {
      floor.addEventListener(type, (event: Event) => {
        const id = from(event.target);
        if (id) show(id);
      });
    }

    floor.addEventListener('click', (event: Event) => {
      const id = from(event.target);
      if (!id) return;
      show(id);
      say(id);
    });

    /*
      The room lights from the pointer. Two custom properties on the scene wrapper, so
      the paint is one compositor-side gradient move and no layout is read per event.
    */
    if (wrap && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
      wrap.addEventListener('pointermove', (event: PointerEvent) => {
        const r = wrap.getBoundingClientRect();
        wrap.style.setProperty('--mx', `${((event.clientX - r.left) / r.width) * 100}%`);
        wrap.style.setProperty('--my', `${((event.clientY - r.top) / r.height) * 100}%`);
      });
    }
  }
</script>

<style>
  /* --- The section --- */

  .floor__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-24);
  }

  .floor__eyebrow {
    /* The lamp is reserved for light sources and live state. The floor is the room the
       light is in, so its eyebrow is the one label on the page that carries it. */
    color: var(--lamp);
    margin-block-end: var(--space-14);
  }

  .floor__lead {
    max-inline-size: 22ch;
  }

  .floor__instruction {
    max-inline-size: 34ch;
    color: var(--dim);
    font-size: var(--step-small);
    line-height: var(--step-small-lh);
  }

  /*
    The two-up row, and the one place in this build where a measured constraint overruled
    the handoff's own layout note.

    The handoff puts the scene and the panel side by side "down to roughly 800px". They
    cannot be: the ten stations are transparent hit targets sized as a percentage of the
    scene box, so **the room's touch targets are a function of how wide the scene is**,
    and sharing the row with a 300px panel makes an agent desk's button 43.8px tall at
    1440 and 37px at 1024 — under the 44 x 44 floor `check-floor-pointer` enforces, at
    every width the side-by-side form exists at.

    So the row engages where the scene can still carry a legal target and not before:

      >= 1200   two-up, and the scene takes twice the free space the panel does, which is
                what lifts an agent button to 44.1px at 1200 and 49.8px at 1440
      740-1199  stacked. The scene takes the full content width, which is more than the
                two-up form ever gives it, so every target grows rather than shrinks
      < 740     the portrait plan (below), where a station's button is 68px by
                construction and the nameplates set at full size

    The room is the site's one bold moment and it is also its only invisible controls.
    Where those two pull apart, the controls win.
  */
  .floor__body {
    margin-block-start: var(--gap-block);
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-col);
    align-items: center;
  }

  .floor__scene {
    position: relative;
    flex: 1 1 100%;
    min-inline-size: min(100%, 280px);
  }

  @media (min-width: 1200px) {
    .floor__scene {
      flex: 2 1 460px;
    }
  }

  .floor-defs {
    position: absolute;
    inline-size: 0;
    block-size: 0;
    overflow: hidden;
  }

  .scene {
    display: block;
    inline-size: 100%;
    block-size: auto;
    overflow: visible;
  }

  /*
    Two plans, swapped on the width at which the wide room's own nameplates stop being
    legible. Below it the portrait plan sets each plate at full size in its own band.
  */
  .scene--tall {
    display: none;
  }

  @media (max-width: 739px) {
    .scene--wide {
      display: none;
    }

    .scene--tall {
      display: block;
      max-inline-size: 320px;
      margin-inline: auto;
    }
  }

  /* The pointer's light. Decorative, and it takes no clicks off the ten buttons. */
  .floor__lit {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      260px circle at var(--mx, 50%) var(--my, 45%),
      rgba(var(--lamp-rgb), 0.14),
      transparent 70%
    );
  }

  /* --- The room's materials --- */

  :global(.fl-slab) {
    fill: url('#fl-slab-g');
    stroke: rgba(var(--f-ink-rgb), 0.16);
    stroke-width: 1;
  }

  :global(.fl-bloom) {
    fill: none;
    stroke: rgba(var(--accent-rgb), 0.1);
    stroke-width: 14;
  }

  :global(.fl-slab-a) {
    stop-color: var(--f-a);
  }

  :global(.fl-slab-b) {
    stop-color: var(--f-b);
  }

  :global(.fl-tile) {
    fill: url('#fl-slab-g');
    stroke: rgba(var(--f-ink-rgb), 0.14);
    stroke-width: 1;
  }

  /* Glass: the desk tops, the cabin props, anything that reads as a lit pane. */
  :global(.fl-pane) {
    fill: url('#fl-glass-g');
    stroke: rgba(var(--f-ink-rgb), 0.28);
    stroke-width: 1;
  }

  :global(.fl-glass-a) {
    stop-color: var(--f-ink);
    stop-opacity: 0.2;
  }

  :global(.fl-glass-b) {
    stop-color: var(--f-ink);
    stop-opacity: 0.05;
  }

  /* The three cabin planes: two walls and a floor, at the alphas that make a corner
     read as two panes meeting rather than as one folded shape. */
  :global(.fl-wall-r) {
    fill: rgba(var(--f-ink-rgb), 0.1);
    stroke: rgba(var(--f-ink-rgb), 0.3);
    stroke-width: 1;
  }

  :global(.fl-wall-l) {
    fill: rgba(var(--f-ink-rgb), 0.16);
    stroke: rgba(var(--f-ink-rgb), 0.3);
    stroke-width: 1;
  }

  :global(.fl-cabin-floor) {
    fill: rgba(var(--f-ink-rgb), 0.06);
    stroke: rgba(var(--f-ink-rgb), 0.2);
    stroke-width: 1;
  }

  :global(.fl-side) {
    fill: var(--f-c);
  }

  :global(.fl-deep) {
    fill: var(--f-d);
  }

  :global(.fl-body) {
    fill: var(--f-c);
    stroke: rgba(var(--f-ink-rgb), 0.2);
    stroke-width: 1;
  }

  :global(.fl-seatpad) {
    fill: rgba(var(--f-ink-rgb), 0.22);
  }

  :global(.fl-headround) {
    fill: rgba(var(--f-ink-rgb), 0.5);
  }

  :global(.fl-plant) {
    fill: rgba(var(--f-ink-rgb), 0.34);
  }

  :global(.fl-cord) {
    fill: rgba(var(--f-ink-rgb), 0.4);
  }

  :global(.fl-shade) {
    fill: var(--f-c);
    stroke: rgba(var(--lamp-rgb), 0.55);
    stroke-width: 1;
  }

  :global(.fl-mark) {
    stroke: rgba(var(--f-ink-rgb), 0.45);
    stroke-width: 1.4;
    fill: none;
  }

  :global(.fl-mark-fill) {
    fill: rgba(var(--f-ink-rgb), 0.24);
  }

  /* --- The dogs --- */

  :global(.fl-ear) {
    fill: rgba(var(--f-ink-rgb), 0.55);
  }

  :global(.fl-head) {
    fill: var(--f-c);
    stroke: rgba(var(--f-ink-rgb), 0.62);
    stroke-width: 1.6;
  }

  :global(.fl-muzzle) {
    fill: rgba(var(--f-ink-rgb), 0.62);
  }

  /* The role mark. It is the one thing on a desk drawn in the lamp colour, because it
     is what the desk is FOR, and the room's rule is that lamp means live. */
  :global(.fl-role) {
    fill: var(--lamp);
    color: var(--lamp);
  }

  /* --- Screens --- */

  :global(.fl-screen-a) {
    stop-color: var(--accent);
    stop-opacity: 0.85;
  }

  :global(.fl-screen-b) {
    stop-color: var(--f-screen-2);
    stop-opacity: 0.35;
  }

  :global(.fl-screen) {
    fill: url('#fl-screen-g');
  }

  /*
    Idle. Staggered per desk off the `--d` index each station carries, because a room
    whose nine screens breathe in unison looks mechanical rather than occupied.
  */
  @media (prefers-reduced-motion: no-preference) {
    :global(.fl-glow) {
      animation: idle 4.8s ease-in-out infinite;
      animation-delay: calc(var(--d, 0) * -0.53s);
    }

    :global(.fl-handoff) {
      animation: handoff 9s linear infinite;
    }

    :global(.fl-cone) {
      animation: breathe 6s ease-in-out infinite;
    }
  }

  :global(.fl-glow) {
    opacity: var(--g, 0.75);
  }

  /* --- The light --- */

  :global(.fl-cone) {
    fill: url('#fl-cone');
    opacity: 0.7;
  }

  :global(.fl-cone-a) {
    stop-color: var(--f-cone);
    stop-opacity: 0.55;
  }

  :global(.fl-cone-b) {
    stop-color: var(--f-cone);
    stop-opacity: 0.03;
  }

  /* --- The pipeline --- */

  :global(.fl-pipe) {
    fill: none;
    stroke: var(--accent);
    stroke-opacity: 0.42;
    stroke-width: 1.4;
    stroke-dasharray: 5 7;
    stroke-linecap: round;
  }

  :global(.fl-handoff) {
    fill: var(--accent);
    opacity: 0;
    offset-rotate: 0deg;
  }

  /* --- Nameplates --- */

  :global(.fl-plate) {
    font-family: var(--tgd-font-mono);
    font-size: 12px;
    font-weight: 500;
    fill: var(--dim);
    /*
      A halo in the band's own ground, painted UNDER the glyphs, so a plate stays legible
      over the slab, over a desk and over the lamp pool alike. `paint-order` is what makes
      the stroke go behind rather than through the letterforms.
    */
    paint-order: stroke;
    stroke: var(--plate-halo);
    /*
      6, not 4. A 4px halo on a 12px mono glyph leaves the thinnest parts of a stroke
      with the desk still showing through, and `qa:contrast` reads exactly those pixels:
      at 4 the light scheme's `Security Auditor` measured 3.36:1 against a desk face
      bleeding through its own label, and at 5 it was still 3.72:1. 6 is where the halo
      closes under every stroke of the site's smallest type, on the darkest face the room
      has. It is a number the measurement chose, not one that was drawn.
    */
    stroke-width: 6;
    stroke-linejoin: round;
  }

  :global(.fl-plate--wall) {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.02em;
    fill: var(--ink);
  }

  /* The chair's plate is the room's conclusion, so it is the one plate in the lamp. */
  :global(.fl-plate--chair) {
    font-size: 13.5px;
    fill: var(--lamp);
  }

  /* --- Selection --- */

  :global(.fl-st[data-on]) :global(.fl-pane),
  :global(.fl-st[data-on]) :global(.fl-wall-l),
  :global(.fl-st[data-on]) :global(.fl-wall-r) {
    stroke: var(--accent);
    stroke-opacity: 0.75;
  }

  :global(.fl-st[data-on]) :global(.fl-glow) {
    opacity: 1;
  }

  /* --- The buttons --- */

  .roster {
    position: absolute;
    inset: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .roster__item {
    display: contents;
  }

  /*
    Ten transparent hit targets, one per station, placed in percentages of whichever
    scene box is live. They are the page's only invisible controls, which is exactly why
    their focus ring is not: an invisible control with an invisible focus state is not a
    control at all.
  */
  .station {
    position: absolute;
    inset-inline-start: var(--x);
    inset-block-start: var(--y);
    inline-size: var(--w);
    block-size: var(--h);
    transform: translate(-50%, -50%);
    padding: 0;
    border: 0;
    background: none;
    border-radius: var(--r-cell);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  /*
    Which plan is live is the ONLY thing this stylesheet decides about a button. Both
    plans' centres and footprints arrive on the element from `plan.ts`, so a change to
    the room's geometry moves its targets without touching a line of CSS.
  */
  .station {
    --x: var(--xw);
    --y: var(--yw);
    --w: var(--ww);
    --h: var(--hw);
  }

  @media (max-width: 739px) {
    .station {
      --x: var(--xt);
      --y: var(--yt);
      --w: var(--wt);
      --h: var(--ht);
    }
  }

  /*
    The selected station. It is a hairline and nothing else: the panel beside the room is
    what carries the selection, and a filled rectangle over the artwork covers the thing
    it is meant to be pointing at.
  */
  .station[data-selected] {
    box-shadow: inset 0 0 0 1px rgba(var(--accent-rgb), 0.3);
  }

  .station:hover {
    box-shadow: inset 0 0 0 1px rgba(var(--accent-rgb), 0.5);
  }

  /* --- The panel --- */

  .floor__slot {
    flex: 1 1 300px;
    min-inline-size: min(100%, 280px);
    padding: var(--space-24);
    /*
      A reservation, not a box: it is tall enough for the LONGEST card, so opening a
      different station never reflows the section under the reader's own thumb.

      Two things about the number. It is a floor on the CONTENT box, because
      `box-sizing: border-box` is set site-wide and a border-box minimum would be short by
      this element's own padding at both ends. And it is width-dependent, because the
      longest card is not the same card at every width: at 1440 the panel is wide and the
      two human cards set in fewer lines than the chair's; at 360 the panel is the full
      column and Tanya's card — the longest body plus an `Owns` line — runs 64px past the
      chair's. Measured, not guessed: `check-floor-slot` opens all ten cards at five
      widths and fails on any page movement at all.
    */
    min-block-size: 380px;
    box-sizing: content-box;
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 768px) {
    .floor__slot {
      min-block-size: 300px;
    }
  }

  .station-card__kind {
    color: var(--lamp);
    margin-block-end: var(--space-12);
  }

  .station-card__name {
    font-size: var(--step-card-title);
  }

  .station-card__lead {
    margin-block-start: var(--space-8);
    color: var(--ink-2);
    font-size: var(--step-small);
    line-height: var(--step-small-lh);
  }

  .station-card__body {
    margin-block-start: var(--space-12);
    color: var(--dim);
    font-size: var(--step-small);
    line-height: var(--step-small-lh);
  }

  .station-card__gate {
    margin-block-start: var(--space-20);
    padding-block-start: var(--space-16);
    border-block-start: 1px solid var(--line);
  }

  .station-card__gate-label {
