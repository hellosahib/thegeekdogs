  }

  .station-card__gate-name {
    margin-block-start: var(--space-4);
    color: var(--ink);
    font-weight: 600;
    font-size: var(--step-small);
  }

  /* --- The roster line --- */

  .floor__roster-label {
    margin-block-start: var(--gap-block);
    color: var(--lamp);
  }

  .floor__roster {
    margin-block-start: var(--space-8);
    max-inline-size: 62ch;
