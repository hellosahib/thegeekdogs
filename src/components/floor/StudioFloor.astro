    /* DESIGN.md §C.7 — 101.33 x 68, 320 x 88 and 104 x 92 of the 320 x 520 box. The
       smallest target anywhere in the portrait set is 101.3 x 68, and 68 is 55% above
       the 44 x 44 floor. */
    .station[data-kind='agent'] {
      --w: 31.6667%;
      --h: 13.0769%;
    }

    .station[data-kind='human'] {
      --w: 100%;
      --h: 16.9231%;
    }

