---
import { THEME_TOGGLE } from '../lib/copy';

/**
 * One control, one per page, last in the header's tab order.
 *
 * A 44 x 44 round glass target containing a 20 x 20 glyph. The glyph is the floor's
 * pendant lamp — the only iconography this site owns — and the two states are
 * distinguished by SHAPE, never by colour: the shade and stem alone when the light
 * scheme is active, the same shade and stem plus a lit cone when the dark scheme is. In
 * greyscale, at 20px, with colour removed, the two states are still
 * one-shape-versus-two.
 *
 * The glyph shows the scheme now in effect; the action lives in the accessible name.
 * The control carries no visible word, so COPY.md §1's `Theme` / `Dark` / `Light` are
 * the group's accessible name and the button's accessible name rather than printed text.
 *
 * The name is written server-side for the DARK scheme — the site is dark-first, so dark
 * is what a document with no stored choice renders — and corrected by the script below
 * the moment it runs, because the scheme itself is decided before first paint by the
 * head script in BaseLayout, which cannot reach an element that does not exist yet.
 */
---

<div class="theme-toggle" role="group" aria-label={THEME_TOGGLE.groupLabel}>
  <button
    type="button"
    class="theme-toggle__button"
    data-theme-toggle
    aria-label={THEME_TOGGLE.toLight.accessibleName}
    data-name-to-light={THEME_TOGGLE.toLight.accessibleName}
    data-name-to-dark={THEME_TOGGLE.toDark.accessibleName}
    data-says-light={THEME_TOGGLE.toLight.announcement}
    data-says-dark={THEME_TOGGLE.toDark.announcement}
  >
    <span class="theme-toggle__plate">
      <svg
        class="theme-toggle__glyph"
        viewBox="0 0 20 20"
        width="20"
        height="20"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M10 1V6.6" fill="none" stroke="currentColor" stroke-width="2"></path>
        <path
          d="M2.6 12.8 L6.6 6.6 H13.4 L17.4 12.8 Z"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linejoin="round"></path>
        <path class="theme-toggle__cone" d="M4.6 14.4 H15.4 L12.4 19.4 H7.6 Z" fill="currentColor"
        ></path>
      </svg>
    </span>
  </button>
  <span class="sr-only" data-theme-announce aria-live="polite"></span>
</div>

<script>
  /*
    The four COPY.md §1 strings travel on the button as data attributes rather than
    through `define:vars`, so there is exactly one place they are written (the frontmatter
    above), the script stays type-checked, and no copy is duplicated into JavaScript.
  */
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const announce = document.querySelector<HTMLElement>('[data-theme-announce]');

  if (button) {
    const sync = (): void => {
      const dark = root.dataset.theme === 'dark';
      const name = dark ? button.dataset.nameToLight : button.dataset.nameToDark;
      if (name) button.setAttribute('aria-label', name);
    };

    sync();

    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('tgd-theme', next);
      } catch {
        // Storage can be unavailable. The choice then lasts the page, which is better
        // than refusing to switch.
      }
      sync();
      const said = next === 'dark' ? button.dataset.saysDark : button.dataset.saysLight;
      if (announce && said) announce.textContent = said;
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
  }

  /*
    A 44 x 44 round glass control. It is the same material as a ghost pill, at the same
    hairline, so the header reads as one row of objects rather than as a nav plus a
    widget.
  */
  .theme-toggle__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 44px;
    block-size: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--glass);
    backdrop-filter: blur(14px);
    color: var(--ink);
    cursor: pointer;
  }

  @supports (-webkit-backdrop-filter: blur(1px)) {
    .theme-toggle__button {
      -webkit-backdrop-filter: blur(14px);
    }
  }

  .theme-toggle__button:hover {
    border-color: var(--line-2);
  }

  .theme-toggle__plate {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .theme-toggle__glyph {
    display: block;
  }

  /*
    Shape, not colour, is the differentiator, and that survives the redesign unchanged:
    the glyph is the room's own pendant lamp, and the two states are the shade and stem
    alone versus the shade and stem plus a lit cone. In greyscale, at 20px, with colour
    removed, the two states are still one-shape-versus-two.

    The cone is the one shape on the site permitted to move on a scheme change. The page
    itself transitions its colours (--dur-scheme) and nothing else, so no half-themed
    frame can exist.
  */
  .theme-toggle__cone {
    opacity: 0;
    transform: scale(0.6);
    transform-origin: 10px 14.4px;
  }

  :global(html[data-theme='dark']) .theme-toggle__cone {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .theme-toggle__cone {
      transition:
        opacity var(--dur-1) var(--ease-out),
        transform var(--dur-1) var(--ease-out);
    }
  }

  /* The ring traces the 44 x 44 target at the site's one offset, and it is round
     because the control is. */
  .theme-toggle__button:focus-visible {
    outline-offset: var(--focus-offset);
    box-shadow: 0 0 0 var(--focus-inner-width) var(--focus-inner);
    border-radius: var(--r-pill);
  }
</style>
