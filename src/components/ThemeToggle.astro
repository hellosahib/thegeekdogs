---
import { THEME_TOGGLE } from '../lib/copy';

/**
 * DESIGN.md §B.10a — one control, one per page, last in the header's tab order.
 *
 * 44 x 44 target containing a 28 x 28 plate at the site's one 3px radius containing a
 * 20 x 20 glyph. The glyph is the floor's pendant lamp, the only iconography this site
 * owns, and the two states are distinguished by SHAPE, never by colour: the shade and
 * stem alone when the light scheme is active, the same shade and stem plus a solid
 * filled cone when the dark scheme is. In greyscale, at 20px, with colour removed, the
 * two states are still one-shape-versus-two.
 *
 * The glyph shows the scheme now in effect; the action lives in the accessible name
 * (COPY.md §1). §B.10a's control carries no visible word — it is 44px wide in §B.8's
 * own header arithmetic (236 + 44 = 280 of 320) — so COPY.md §1's visible labels
 * `Theme` / `Dark` / `Light` are carried as the group's accessible name and the
 * button's accessible name rather than as printed text. Noted in
 * docs/scratch/engineer.md as the one place the two documents disagree.
 *
 * The name is written server-side for the light scheme and corrected by the script
 * below the moment it runs, because the scheme itself is decided before first paint by
 * the head script in BaseLayout, which cannot reach an element that does not exist yet.
 */
---

<div class="theme-toggle" role="group" aria-label={THEME_TOGGLE.groupLabel}>
  <button
    type="button"
    class="theme-toggle__button"
    data-theme-toggle
    aria-label={THEME_TOGGLE.toDark.accessibleName}
    data-name-to-light={THEME_TOGGLE.toLight.accessibleName}
    data-name-to-dark={THEME_TOGGLE.toDark.accessibleName}
    data-says-light={THEME_TOGGLE.toLight.announcement}
    data-says-dark={THEME_TOGGLE.toDark.announcement}
  >
    <span class="theme-toggle__plate">
      <svg
        class="theme-toggle__glyph"
        viewBox="0 0 20 20"
        width="20"
        height="20"
        aria-hidden="true"
        focusable="false"
      >
        <!-- stem -->
        <path d="M10 1V6.6" fill="none" stroke="currentColor" stroke-width="2"></path>
        <!-- shade: an outlined trapezoid -->
        <path
          d="M2.6 12.8 L6.6 6.6 H13.4 L17.4 12.8 Z"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linejoin="round"></path>
        <!-- cone: present only while the dark scheme is active -->
        <path class="theme-toggle__cone" d="M4.6 14.4 H15.4 L12.4 19.4 H7.6 Z" fill="currentColor"
        ></path>
      </svg>
    </span>
  </button>
  <span class="sr-only" data-theme-announce aria-live="polite"></span>
</div>

<script>
  /*
    The four COPY.md §1 strings travel on the button as data attributes rather than
    through `define:vars`, so there is exactly one place they are written (the frontmatter
    above), the script stays type-checked, and no copy is duplicated into JavaScript.
  */
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const announce = document.querySelector<HTMLElement>('[data-theme-announce]');

  if (button) {
    const sync = (): void => {
      const dark = root.dataset.theme === 'dark';
      const name = dark ? button.dataset.nameToLight : button.dataset.nameToDark;
      if (name) button.setAttribute('aria-label', name);
    };

    sync();

    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('tgd-theme', next);
      } catch {
        // Storage can be unavailable. The choice then lasts the page, which is better
        // than refusing to switch.
      }
      sync();
      const said = next === 'dark' ? button.dataset.saysDark : button.dataset.saysLight;
      if (announce && said) announce.textContent = said;
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
  }

  .theme-toggle__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 44px;
    block-size: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--tgd-ink);
    cursor: pointer;
  }

  /* The plate is not a border and not a fill — it is the hit area made visible at
     the same weight as a nav label (DESIGN.md §B.10a). */
  .theme-toggle__plate {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 28px;
    block-size: 28px;
    border-radius: 3px;
  }

  .theme-toggle__glyph {
    display: block;
  }

  /*
    Shape, not colour, is the differentiator. The cone exists only while the dark
    scheme is in effect. The only thing on the site permitted to move on a theme
    change is this one shape (§B.10a): --dur-1, opacity and transform only. The page
    itself never transitions — no colour, background, border or fill anywhere carries
    one, so no half-themed frame can exist.
  */
  .theme-toggle__cone {
    opacity: 0;
    transform: scale(0.6);
    transform-origin: 10px 14.4px;
  }

  :global(html[data-theme='dark']) .theme-toggle__cone {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .theme-toggle__cone {
      transition:
        opacity var(--dur-1) var(--ease-out),
        transform var(--dur-1) var(--ease-out);
    }
  }

  /* §B.10a — the ring traces the 44 x 44 target, not the 28 x 28 plate. */
  .theme-toggle__button:focus-visible {
    outline: var(--focus-outer-width) solid var(--focus-outer);
    outline-offset: 0;
    box-shadow: inset 0 0 0 var(--focus-inner-width) var(--focus-inner);
    border-radius: 4px;
  }
</style>
