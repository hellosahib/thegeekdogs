---
import type { CollectionEntry } from 'astro:content';
import LegalPage from './LegalPage.astro';
import { STUDIO_EMAIL } from '../lib/copy';

/**
 * A product's privacy policy. The page's arrangement is `LegalPage.astro`; everything
 * here is the mapping from one product entry onto it.
 *
 * Nothing here is name-dependent. The policy names the product the way every other route
 * on this site does — by the entry's own `descriptiveName` — which is a settled name for
 * one product (Milan, QUESTIONS.md item 78) and a description for a product that has not
 * chosen one. Either renders; the page does not know which it was handed.
 *
 * The studio address is `STUDIO_EMAIL`, not a string in the product's JSON. A policy that
 * printed its own inbox could drift from the one on `/contact/`, and the address in a
 * privacy policy is the one address that has to be answered.
 */
interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const d = product.data;

const policy = d.privacyPolicy;
if (!policy) {
  throw new Error(
    `${product.id} has no privacyPolicy. A policy route may not render an empty page.`,
  );
}

/*
  The back link reads as a sentence, and a named product does not take an article: "Back
  to Milan", but "Back to the wedding planner". `name` is the entry's own test for which
  it is — it is null until a name is settled — so the article is decided by the data
  rather than by a second field nobody would remember to set.
*/
const backLabel = d.name ? `Back to ${d.name}` : `Back to the ${d.descriptiveName.toLowerCase()}`;
---

<LegalPage
  title={policy.meta.title}
  description={policy.meta.description}
  eyebrow={d.descriptiveName}
  headline={policy.headline}
  updated={policy.updated}
  intro={policy.intro}
  sections={policy.sections}
  closing={policy.contact}
  action={{ href: `mailto:${STUDIO_EMAIL}`, label: STUDIO_EMAIL }}
  secondaryAction={d.accountDeletion
    ? { href: `/work/${d.slug}/delete-account/`, label: 'Ask for your account and data to be deleted' }
    : undefined}
  backHref={`/work/${d.slug}/`}
  backLabel={backLabel}
/>
