---
import type { CollectionEntry } from 'astro:content';
import { assertYearsOnly, yearsOnly } from '../../lib/person';

type Role = CollectionEntry<'people'>['data']['workHistory'][number];

/**
 * A role card: the company, its date range, what the company does, the role line, and
 * the products and stack under it.
 *
 * These are the footnotes to the map above them — the map is the argument, the cards
 * are the evidence — so they are quieter than it: glass, one accent line for the role,
 * everything else in the body ink.
 *
 * The studio's own card is the one exception. It is the only company on the list the
 * reader can go and install, so it takes the emphasised border and closes on the lamp
 * line its entry carries. The lamp is reserved for light and for live state, and a
 * product that is shipping right now is live state. Both the border and the line are
 * driven by the data — `company === 'TheGeekDogs'` for the border, `liveLine` for the
 * text — so neither is a string typed into a component.
 *
 * Years only, never months: the month boundaries live in `src/data/people/*.json` where
 * they settle which card a boundary belongs to, and are stripped at the point of
 * printing. `assertYearsOnly` fails the build if one survives.
 */
interface Props {
  entry: Role;
  /** Position in the list, which decides the direction of the resting tilt. */
  index: number;
}

const { entry, index } = Astro.props;
const years = assertYearsOnly(yearsOnly(entry.years), entry.company);
const isStudio = entry.company === 'TheGeekDogs';
---

<article
  class="role card"
  data-lift
  data-studio={isStudio ? '' : undefined}
  style={`--tilt:${index % 2 === 0 ? '-0.4' : '0.4'}deg`}
>
  <header class="role__head">
    <h3 class="role__company">{entry.company}</h3>
    <p class="role__years mono">{years}</p>
  </header>

  <p class="role__what">{entry.whatTheyDo}</p>

  {/* The role line is the one accent mark on the card: it is the answer to "what was he
      actually doing there", which is what the section's heading asks. */}
  {entry.role && <p class="role__role accent">{entry.role}</p>}

  <ul class="role__stack">
    {entry.productsStack.map((line) => <li>{line}</li>)}
  </ul>

  {entry.ownershipLine && <p class="role__extra">{entry.ownershipLine}</p>}
  {entry.attributedAccount && <p class="role__extra">{entry.attributedAccount}</p>}
  {entry.projectLine && <p class="role__extra">{entry.projectLine}</p>}

  {entry.liveLine && <p class="role__live mono">{entry.liveLine}</p>}
</article>

<style>
  .role {
    border-radius: var(--r-role);
    padding: var(--space-24);
    block-size: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .role[data-studio] {
    border-color: var(--line-2);
  }

  .role__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .role__company {
    font-size: var(--step-card-title);
  }

  .role__years {
    font-size: var(--step-date);
    color: var(--dim);
  }

  .role__what {
    color: var(--dim);
    font-size: var(--step-small);
    line-height: var(--step-small-lh);
  }

  .role__role {
    font-weight: 600;
    font-size: var(--step-small);
  }

  .role__stack {
    list-style: none;
    display: grid;
    gap: var(--space-8);
    color: var(--ink-2);
    font-size: var(--step-small);
    line-height: var(--step-small-lh);
  }

  .role__extra {
    color: var(--dim);
    font-size: var(--step-small);
    line-height: var(--step-small-lh);
  }

  .role__live {
    margin-block-start: auto;
    padding-block-start: var(--space-16);
    border-block-start: 1px solid var(--line);
    color: var(--lamp);
    font-size: var(--step-caption);
  }
</style>
