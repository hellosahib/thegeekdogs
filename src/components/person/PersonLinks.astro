---
import type { CollectionEntry } from 'astro:content';

/**
 * COPY.md §6.5 and §7.5 — GitHub, LinkedIn and the person's own address, as plain links
 * and nothing more prominent. Item 39 put GitHub on both pages; item 40 made LinkedIn
 * the link CTA. Items 17 and 18 closed everything else, so these three and the quiet
 * back link at the top of the page are the whole of it.
 *
 * Never print contribution counts, streaks or repo numbers (§6.5, §7.5).
 *
 * COPY.md §10.5's rule is what builds the two profile links' accessible names: "append
 * `Opens a new tab.` to the link's own name". That is deliberate rather than a shortcut.
 * §6.5 and §7.5 each also write the name out in full — `Sahib Singh on GitHub. Opens a
 * new tab.` — and those strings FAIL SC 2.5.3, Label in Name, against §6.5's own visible
 * label `Sahib on GitHub`: the accessible name has to contain the visible text and
 * `Sahib Singh on GitHub` does not contain `Sahib on GitHub`. Lighthouse's
 * `label-content-name-mismatch` audit caught it on /sahib/ and took accessibility to 98.
 * §10.5's rule produces a name that contains the label by construction, which is why the
 * general rule wins over the two written-out strings — the same class of ruling as §E.1's
 * stroke alpha, where a Perf & A11y line outranks a preference. The written names are
 * kept in `copy.ts` so the conflict is visible rather than quietly resolved.
 *
 * The address link is unaffected: `Email Sahib at sahiboffc@gmail.com` contains its own
 * visible label, so §6.5's string is used exactly as written.
 */
interface LabelledLink {
  label: string;
  accessibleName: string;
}

interface Props {
  person: CollectionEntry<'people'>;
  links: {
    github: LabelledLink;
    linkedin: LabelledLink;
    email: LabelledLink & { address: string };
  };
}

const { person, links } = Astro.props;
---

<ul class="person-links">
  <li>
    <a
      class="link"
      href={person.data.socials.github}
      target="_blank"
      rel="noopener noreferrer"
    >
      {links.github.label}
      <span class="sr-only"> Opens a new tab.</span>
    </a>
  </li>
  <li>
    <a
      class="link"
      href={person.data.socials.linkedin}
      target="_blank"
      rel="noopener noreferrer"
    >
      {links.linkedin.label}
      <span class="sr-only"> Opens a new tab.</span>
    </a>
  </li>
  <li>
    <a class="link" href={`mailto:${links.email.address}`} aria-label={links.email.accessibleName}>
      {links.email.label}
    </a>
  </li>
</ul>

<style>
  .person-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-32);
    row-gap: var(--space-4);
  }

  .person-links a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
  }
</style>
