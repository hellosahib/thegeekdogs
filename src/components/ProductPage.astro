---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StageTrack from './StageTrack.astro';
import { productGraph } from '../lib/jsonld';

/**
 * The shell both `/work/*` case studies use. Identical on both routes — the wedding
 * planner is not a reduced version of the Pocket Manager page, it is the same page with
 * a different entry behind it.
 *
 * That identity is what makes the thin page read as restraint rather than as an
 * unfinished one. The page with one screenshot gives that screenshot the width the other
 * page gives four, and the sections it does not have simply are not there — no greyed
 * headings, no "coming soon", no reserved slots with nothing in them. The design's answer
 * to having less to show is to show less, at full size.
 *
 * The stage track sits directly under the h1: on the shipped product "Live" is the
 * strongest fact on the page, and on the other one the stage is the whole answer to
 * "when".
 *
 * Nothing here renders a field that is empty. No store link where there is nothing to
 * link to, no product name where a human has not picked one, no screenshot whose alt
 * line is not written.
 */
interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const d = product.data;

/*
  One display width, so the portrait captures form a row of equal objects and every one
  of them carries explicit dimensions. 280 CSS px at 2x is 560 real pixels against a
  1206–1440px source, so the pipeline is always downscaling.

  The FIRST capture is eager and `fetchpriority="high"`; every other one is lazy. On
  these two routes the first screenshot is the LCP element, and lazy its load did not
  start until 1.4s in.
*/
const SHOT_WIDTH = 280;

/*
  A page with ONE screenshot does not render a standalone screenshot row: the shot is
  placed inside the section it is evidence for, beside that section's prose, at more than
  twice the width. A single 280px thumbnail alone at the left of a 1200px row is the
  smallest object on the page, and on the thin page that one screen is the whole
  differentiator — it cannot also be the page's smallest mark.

  The source is 1206 x 2622, so 603 is the largest display width that still downscales
  at 2x — but 603 is not what it is displayed at. Rendered at its full 603 the frame ran
  roughly 1,000px tall beside a column of prose that ran out about 600px earlier, and one
  oversized asset next to 600px of empty column is the visual signature of a page waiting
  for content. The thin page is supposed to read as restraint. It is capped at 380 in CSS,
  which is the width its own paragraph supports, and still served at 603 so the raster is
  never upscaled.
*/
const singleShot = d.screenshots.length === 1;
const SOLO_SHOT_WIDTH = 603;
const soloShot = singleShot ? d.screenshots[0] : undefined;

/* At most two screenshots above the fold, and the column count is the screenshot count
   capped at two, so a page is laid out for the number of shots it actually has. */
const shotColumns = Math.min(d.screenshots.length, 2);

const schema = productGraph(product);
---

<BaseLayout
  title={d.meta.title}
  description={d.meta.description}
  ogTitle={d.meta.ogTitle}
  ogDescription={d.meta.ogDescription}
  ogImage={d.slug}
  schema={schema}
>
  <section class="section page-section">
    <div class="shell">
      <div class="product-head">
        <p class="eyebrow accent">{d.descriptiveName}</p>
        <h1 class="product-head__headline">{d.headline}</h1>
        <p class="lede product-head__subhead">{d.subhead}</p>

        <div class="glass product-head__track">
          {/* The h1 and the eyebrow above have already named it twice over. */}
          <StageTrack stage={d.stage} label={d.descriptiveName} showName={false} />
        </div>

        {
          d.storeUrl && d.storeLink && (
            <p class="product-head__store">
              <a
                class="pill pill--accent"
                href={d.storeUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={d.storeLink.accessibleName}
              >
                {d.storeLink.label}
              </a>
            </p>
          )
        }
      </div>

      {/*
        The frame. A screenshot dropped in raw reads as an asset pasted onto a page; the
        same capture inside a glass surround with the room's own hairline reads as a
        device standing in the room. It is padding, a radius and a border — no chrome, no
        drawn notch, nothing pretending to be hardware.
      */}
      {
        d.screenshots.length > 1 && (
          <ul class="shots" style={`--shot-columns: ${shotColumns}`} data-rv>
            {d.screenshots.map((shot, index) => (
              <li class="glass shots__item">
                <Picture
                  src={shot.src}
                  alt={shot.alt}
                  formats={['avif', 'webp']}
                  width={SHOT_WIDTH}
                  densities={[1, 2]}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : undefined}
                  decoding="async"
                />
              </li>
            ))}
          </ul>
        )
      }

      <div class="product-body">
        {
          d.sections.map((section, index) => (
            <section class="product-section" data-shot={index === 0 && soloShot ? '' : undefined}>
              <div class="product-section__inner" data-rv>
                {index === 0 && soloShot && (
                  <div class="glass product-section__shot">
                    <Picture
                      src={soloShot.src}
                      alt={soloShot.alt}
                      formats={['avif', 'webp']}
                      width={SOLO_SHOT_WIDTH}
                      densities={[1, 2]}
                      loading="eager"
                      fetchpriority="high"
                      decoding="async"
                    />
                  </div>
                )}
                <div class="product-section__content">
                  <h2 class="product-section__heading">{section.heading}</h2>
                  {section.body && <p class="product-section__body muted">{section.body}</p>}
                  {section.showFeatures && d.features.length > 0 && (
                    <ul class="product-section__features">
                      {d.features.map((feature) => (
                        <li class="card product-section__feature">{feature}</li>
                      ))}
                    </ul>
                  )}
                  {section.closingLine && (
                    <p class="quote product-section__closing">{section.closingLine}</p>
                  )}
                </div>
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-section {
    flex: 1 0 auto;
  }

  .product-head__headline {
    margin-block-start: var(--space-14);
    max-inline-size: 20ch;
  }

  .product-head__subhead {
    margin-block-start: var(--space-24);
    max-inline-size: 56ch;
  }

  .product-head__track {
    margin-block-start: var(--space-32);
    padding: var(--space-24);
  }

  .product-head__store {
    margin-block-start: var(--space-24);
  }

  .shots {
    margin-block-start: var(--gap-block);
    list-style: none;
    display: grid;
    grid-template-columns: repeat(var(--shot-columns, 2), minmax(0, max-content));
    gap: var(--gap-col);
    justify-content: start;
  }

  .shots__item {
    padding: var(--space-12);
    border-radius: var(--r-panel);
    line-height: 0;
  }

  .shots :global(img),
  .product-section__shot :global(img) {
    display: block;
    block-size: auto;
    max-inline-size: 100%;
    border-radius: var(--r-cell);
  }

  @media (max-width: 719px) {
    .shots {
      grid-template-columns: minmax(0, max-content);
    }
  }

  .product-body {
    margin-block-start: var(--section-pad);
    display: grid;
    gap: var(--section-pad);
  }

  /*
    Two columns — the heading on the left, its prose on the right — so a case study fills
    the content width the rest of the site uses. As a single measure-capped column both
    case studies sat in the left half of a 1360 shell with nothing in the right half at
    any scroll position, and read as a narrower, different site.
  */
  .product-section__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--gap-col);
    align-items: start;
  }

  /* The section that carries the solo shot is the one two-column arrangement here: the
     picture and the sentence that explains it, side by side, and no third thing. */
  .product-section[data-shot] .product-section__inner {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }

  .product-section__shot {
    padding: var(--space-12);
    border-radius: var(--r-panel);
    line-height: 0;
    justify-self: start;
    max-inline-size: 380px;
  }

  .product-section__heading {
    max-inline-size: 18ch;
    font-size: var(--step-subsection);
  }

  .product-section__body {
    margin-block-start: var(--space-20);
    max-inline-size: 62ch;
  }

  .product-section__features {
    margin-block-start: var(--space-24);
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--space-12);
  }

  .product-section__feature {
    padding: var(--space-16);
    font-size: var(--step-small);
    line-height: var(--step-small-lh);
    color: var(--ink-2);
  }

  .product-section__closing {
    margin-block-start: var(--space-28);
    max-inline-size: 30ch;
  }
</style>
