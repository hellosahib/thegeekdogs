---
import { getCollection } from 'astro:content';
import { STRIP_ROW_LINKS } from '../lib/copy';
import { assertYearsOnly, yearsOnly } from '../lib/person';

/**
 * "Where they've worked": one row per founder, each row a name, a link to that person's
 * own page, and their companies as glass cards.
 *
 * The cards carry a company and a date range and nothing else. The row is an index, not
 * a history: what a person actually did at each of those companies is on their own page,
 * and the link at the end of the row is how you get there. Two facts per card is what
 * keeps a row of five scannable.
 *
 * Years only, never months. The month boundaries are real and they live in
 * `src/data/people/*.json` where they settle which card a boundary belongs to; they are
 * stripped at the point of printing rather than deleted from the data, which is the only
 * arrangement in which the source and the page can both be right. `assertYearsOnly`
 * fails the build if one survives.
 *
 * The ±0.5° resting tilt is per card and alternates. It is small enough that no single
 * card looks crooked and large enough that a row of them stops looking printed.
 */
const people = await getCollection('people');
const order = ['sahib-singh', 'tanya-jain'];

const rows = order
  .map((slug) => people.find((p) => p.data.slug === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p))
  .map((person) => ({
    slug: person.data.slug,
    name: person.data.name,
    link: STRIP_ROW_LINKS[person.data.slug],
    cards: person.data.workHistory.map((role) => ({
      company: role.company,
      years: assertYearsOnly(yearsOnly(role.years), `${person.data.slug} / ${role.company}`),
    })),
  }));
---

<section class="section worked">
  <div class="shell">
    <p class="eyebrow accent" data-rv>Where they've worked</p>

    {
      rows.map((row) => (
        <div class="worked__row" data-rv>
          <div class="worked__head">
            <h2 class="worked__name">{row.name}</h2>
            {row.link && (
              <a class="link-row" href={row.link.href} aria-label={row.link.accessibleName}>
                {row.link.label}
              </a>
            )}
          </div>
          <ul class="worked__cards">
            {row.cards.map((card, i) => (
              <li
                class="card worked__card"
                data-lift
                style={`--tilt:${i % 2 === 0 ? '0.5' : '-0.5'}deg`}
              >
                <p class="worked__company">{card.company}</p>
                <p class="worked__years mono">{card.years}</p>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .worked__row {
    margin-block-start: var(--gap-block);
  }

  .worked__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-12);
    margin-block-end: var(--space-20);
  }

  .worked__name {
    font-size: var(--step-subsection);
  }

  .worked__cards {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: var(--gap-col);
  }

  .worked__card {
    min-block-size: 132px;
    padding: var(--space-20);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-16);
  }

  .worked__company {
    font-size: var(--step-list-title);
    font-weight: 600;
    letter-spacing: var(--step-title-tracking);
  }

  /* The date is a number, so it is mono. It sits at the bottom of the card, in the
     position a shelf label puts a price: the thing you scan a row for. */
  .worked__years {
    font-size: var(--step-date);
    color: var(--dim);
  }
</style>
