---
import { STAGES } from '../content.config';
import { STAGE_LABELS, STATE_WORDS, stageSteps } from '../lib/stages';
import type { Stage } from '../content.config';

/**
 * The compact, two-product stage view (DESIGN.md §E.3, COPY.md §2.8, §10.4).
 *
 * REVIEWS.md, 2026-09-05, arbitration 4: this is one `<ol>` per product, not a
 * `<table>`. Brief §6.2 is explicit that the component is an ordered list with the
 * current step marked via `aria-current="step"`. The shared axis §E.3 wants comes from
 * a visible, aligned header row of stage names plus the two lists carrying identical
 * item text in identical order.
 *
 * Step-1 review items 2 and 3, both fixed here by the same mechanism. The five columns
 * are now defined once, by the axis, and both runners and the label row are laid on it
 * with `subgrid` — so a node's column position no longer depends on the sum of the
 * widths of the nodes before it, and a label is centred on its own node rather than on
 * a second, independent grid. The current node is 18px against the others' 10px and it
 * is centred in its column like every other node, so the size difference pushes nothing
 * rightward.
 *
 * Step-1 review item 17: the trailing `Stage:` line is gone at >=768, where the header
 * row already names all five stages and the current node is the largest mark on the
 * axis. It stays below 768, where §E.3 drops the four other labels — and it now sits
 * *above* its track, which is where COPY.md §10.4 puts it.
 *
 * States survive greyscale on three redundant channels (DESIGN.md §E.1, §E.1a): size,
 * internal structure, and the pattern of the outgoing connector. Every value that was
 * `--floor` in light resolves through `--ink` so the component is one component in both
 * schemes. The state word is also spoken (COPY.md §10.4), so nothing rests on the
 * graphic at all.
 */
interface Runner {
  label: string;
  stage: Stage;
}

interface Props {
  runners: Runner[];
}

const { runners } = Astro.props;
const headings = STAGES.map((key) => STAGE_LABELS[key].label);
---

<div class="track">
  <p class="track__head" aria-hidden="true">
    <span class="track__spacer"></span>
    {headings.map((label) => <span class="track__head-cell">{label}</span>)}
  </p>

  {
    runners.map((runner) => {
      const steps = stageSteps(runner.stage);
      const current = STAGE_LABELS[runner.stage].label;
      return (
        <div class="track__runner">
          <p class="track__product">{runner.label}</p>
          <p class="track__now small" aria-hidden="true">{`Stage: ${current}`}</p>
          <ol class="track__list" aria-label={`${runner.label} build stage`}>
            {steps.map((step) => (
              <li
                class="track__step"
                data-state={step.state}
                aria-current={step.state === 'current' ? 'step' : undefined}
              >
                <span class="sr-only">{`${step.label}. ${STATE_WORDS[step.state]}.`}</span>
                <span class="track__node" aria-hidden="true" />
              </li>
            ))}
          </ol>
        </div>
      );
    })
  }
</div>

<style>
  .track {
    display: grid;
    gap: var(--space-24);
  }

  .track__head {
    display: none;
  }

  .track__runner {
    display: grid;
    gap: var(--space-8);
  }

  .track__product {
    font-family: var(--tgd-font-display);
    font-weight: 600;
    font-variation-settings: 'wdth' var(--wdth-numeral);
    font-size: var(--step-title);
    line-height: var(--step-title-lh);
  }

  .track__now {
    color: var(--tgd-muted);
  }

  /* < 768: nodes only, 140px of mini track, no per-node labels (§E.3). */
  .track__list {
    display: flex;
    align-items: center;
    list-style: none;
    inline-size: 140px;
  }

  .track__step {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    block-size: 20px;
  }

  .track__step:last-child {
    flex: 0 0 auto;
  }

  /* DESIGN.md §E.1 — the outgoing connector's pattern is the third channel. It is drawn
     from this node's centre to the next node's, which at equal column widths is exactly
     one column. */
  .track__step:not(:last-child)::after {
    content: '';
    position: absolute;
    inset-inline-start: 50%;
    inset-block-start: 50%;
    inline-size: 100%;
    block-size: 0;
    border-block-start: 2px solid var(--tgd-ink);
  }

  .track__step[data-state='upcoming']:not(:last-child)::after {
    border-block-start-style: dashed;
    border-block-start-color: var(--node-future-connector);
  }

  .track__node {
    position: relative;
    z-index: 1;
    display: block;
    inline-size: 10px;
    block-size: 10px;
    border-radius: 50%;
  }

  .track__step[data-state='complete'] .track__node {
    background-color: var(--tgd-ink);
  }

  .track__step[data-state='upcoming'] .track__node {
    background-color: transparent;
    border: 1.5px solid var(--node-future-stroke);
  }

  /* The current node: 18px, a ring with a concentric 8px core and a 4px clear gap.
     The only node with two parts. */
  .track__step[data-state='current'] .track__node {
    inline-size: 18px;
    block-size: 18px;
    border: 3px solid var(--tgd-ink);
    background-color: transparent;
  }

  .track__step[data-state='current'] .track__node::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    inline-size: 8px;
    block-size: 8px;
    border-radius: 50%;
    background-color: var(--node-current-core);
  }

  /*
    >= 768 — one axis, five fixed columns, defined once on .track and inherited by the
    label row and by both runners through subgrid. The column gap is zero on purpose:
    the connector spans exactly one column, so a gap would leave the line short of the
    next node.
  */
  @media (min-width: 768px) {
    .track {
      grid-template-columns: minmax(7rem, 11rem) repeat(5, minmax(0, 1fr));
      gap: var(--space-16) 0;
    }

    .track__head,
    .track__runner {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: subgrid;
      align-items: center;
      margin: 0;
      max-inline-size: none;
    }

    .track__head {
      color: var(--tgd-muted);
      font-size: var(--step-micro);
      line-height: var(--step-micro-lh);
      align-items: end;
    }

    /* Height is reserved for the longest label so nothing shifts (§E.2). */
    .track__head-cell {
      text-align: center;
      padding-inline: var(--space-4);
      min-block-size: calc(3 * var(--step-micro) * var(--step-micro-lh));
    }

    .track__product {
      padding-inline-end: var(--space-16);
      font-size: var(--step-body);
      line-height: var(--step-body-lh);
    }

    /* Step-1 review item 17 — the header row already names all five stages here. */
    .track__now {
      display: none;
    }

    .track__list {
      grid-column: 2 / -1;
      display: grid;
      grid-template-columns: subgrid;
      inline-size: auto;
      block-size: 20px;
    }

    .track__step {
      flex: none;
      block-size: 20px;
    }

    .track__step:last-child {
      flex: none;
    }
  }

  @media (min-width: 1024px) {
    .track__head {
      font-size: var(--step-small);
      line-height: var(--step-small-lh);
    }

    .track__head-cell {
      min-block-size: calc(2 * var(--step-small) * var(--step-small-lh));
    }
  }
</style>
