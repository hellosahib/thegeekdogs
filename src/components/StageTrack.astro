---
import { STAGE_LABELS, STATE_WORDS, stageSteps, TRACK_GROUP_LABEL, stageSummary } from '../lib/stages';
import type { Stage } from '../content.config';

/**
 * The build-stage track. One product, five stages, one column per stage.
 *
 * This is the site's one stage device now: the home page's proof panel, `/work/` and
 * both product pages render exactly this component, so a visitor who learns to read it
 * once has learned to read it everywhere. The compressed second form it replaces is
 * gone with the layout that needed it.
 *
 * The three states differ on THREE redundant channels — the node's size, its internal
 * structure, and the pattern of the connector leaving it — so the component survives
 * greyscale and forced colours. The state word is spoken on every item as well, so
 * nothing at all rests on the graphic.
 *
 * Below 560 the five columns become five rows: five labels across a 320px viewport give
 * 64px each, and `Submitted for review` cannot set in 64px at any size a person would
 * read. The vertical form has no horizontal extent to run out of.
 */
interface Props {
  stage: Stage;
  /** Names the list, so a panel carrying two tracks says which is which. */
  label: string;
  /**
   * Whether to PRINT that name above the track.
   *
   * It is on where the track has to identify itself — the home page's proof panel
   * carries two of them and nothing else says which is which — and off wherever the
   * thing above it has already named the product, which is every other placement: the
   * `/work/` card's own heading, and a product page's h1. The accessible name is built
   * from `label` either way, so a screen reader always hears which track it is in.
   */
  showName?: boolean;
}

const { stage, label, showName = true } = Astro.props;
const steps = stageSteps(stage);
---

<div class="track">
  <p class="track__head" data-unnamed={showName ? undefined : ''}>
    {showName && <span class="track__name">{label}</span>}
    <span class="track__now mono" aria-hidden="true">{stageSummary(stage)}</span>
  </p>
  <ol class="track__list" aria-label={`${label} ${TRACK_GROUP_LABEL}`}>
    {
      steps.map((step) => (
        <li
          class="track__step"
          data-state={step.state}
          aria-current={step.state === 'current' ? 'step' : undefined}
        >
          <span class="sr-only">{`${step.label}. ${STATE_WORDS[step.state]}.`}</span>
          <span class="track__node" aria-hidden="true" />
          <span class="track__label micro" aria-hidden="true">
            {STAGE_LABELS[step.key].label}
          </span>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .track__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-12);
  }

  /* With no name beside it the stage line has the row to itself, and it belongs at the
     start of that row rather than pushed to the far end of an empty one. */
  .track__head[data-unnamed] {
    justify-content: flex-start;
  }

  .track__name {
    font-weight: 600;
    font-size: var(--step-list-title);
    letter-spacing: var(--step-title-tracking);
  }

  /* The one line that says where the product actually is. Lamp, because "where it is
     now" is live state, and live state is what the lamp colour is reserved for. */
  .track__now {
    color: var(--lamp);
    font-size: var(--step-caption);
  }

  .track__list {
    margin-block-start: var(--space-20);
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    align-items: start;
  }

  .track__step {
    position: relative;
    display: grid;
    justify-items: start;
    row-gap: var(--space-12);
    padding-inline-end: var(--space-8);
  }

  /*
    The connector belongs to the step it LEAVES, so its pattern says what the step
    behind it is: solid accent out of a completed stage, dashed dim out of anything not
    reached yet. The last step has nothing to connect to.
  */
  .track__step::after {
    content: '';
    position: absolute;
    inset-block-start: 9px;
    inset-inline-start: 20px;
    inline-size: calc(100% - 20px);
    border-block-start: 2px solid var(--dim);
    opacity: 0.5;
  }

  .track__step:last-child::after {
    content: none;
  }

  .track__step[data-state='complete']::after {
    border-block-start-style: solid;
    border-block-start-color: var(--accent);
    opacity: 1;
  }

  .track__step[data-state='current']::after,
  .track__step[data-state='upcoming']::after {
    border-block-start-style: dashed;
  }

  .track__node {
    inline-size: 12px;
    block-size: 12px;
    border-radius: 50%;
    background: var(--accent);
    margin-block-start: 3px;
  }

  /* The one node the reader is meant to find: bigger, hollow, haloed, and in the lamp,
     which on this site means "live". */
  .track__step[data-state='current'] .track__node {
    inline-size: 20px;
    block-size: 20px;
    margin-block-start: 0;
    background: transparent;
    border: 3px solid var(--lamp);
    box-shadow: 0 0 0 6px rgba(var(--lamp-rgb), 0.14);
  }

  .track__step[data-state='upcoming'] .track__node {
    background: transparent;
    border: 2px solid var(--dim);
    opacity: 0.7;
  }

  .track__label {
    color: var(--dim);
    line-height: 1.35;
    /* Two lines are reserved at every width, so a track whose current stage has the
       longest label is the same height as one whose current stage is `Live`. */
    min-block-size: 2.7em;
  }

  .track__step[data-state='current'] .track__label {
    color: var(--ink);
    font-weight: 600;
  }

  /* Five rows rather than five columns, where five columns would give each label 64px. */
  @media (max-width: 559px) {
    .track__list {
      grid-template-columns: none;
      row-gap: var(--space-4);
    }

    .track__step {
      grid-template-columns: 20px minmax(0, 1fr);
      column-gap: var(--space-16);
      align-items: center;
      row-gap: 0;
      min-block-size: 44px;
      padding-inline-end: 0;
    }

    .track__node {
      justify-self: center;
      margin-block-start: 0;
    }

    .track__step::after {
      inset-block-start: 22px;
      inset-inline-start: 9px;
      inline-size: 0;
      block-size: calc(100% - 22px);
      border-block-start: 0;
      border-inline-start: 2px solid var(--dim);
    }

    .track__step[data-state='complete']::after {
      border-inline-start-color: var(--accent);
      border-inline-start-style: solid;
    }

    .track__step[data-state='current']::after,
    .track__step[data-state='upcoming']::after {
      border-inline-start-style: dashed;
    }

    .track__label {
      min-block-size: 0;
    }
  }
</style>
