---
import type { CollectionEntry } from 'astro:content';

/**
 * The coverage map, and the page's centre.
 *
 * Five surfaces crossed against five places. A cell is filled only where a real product
 * can be named, and the two states are the whole grammar: attributed, with the product
 * printed inside it, or empty, which is no claim at all. There is deliberately no third
 * "asserted" state, because a two-state map cannot lie by omission — **the gaps are as
 * informative as the fills.**
 *
 * **It is a real `<table>`**, not a grid of divs: a matrix whose meaning is "this
 * surface, at this place" needs row and column headers, and a table gives a screen
 * reader both for free through `scope`.
 *
 * **It does not reflow. It scrolls.** Six columns — a 130px label column and five
 * company columns — at a 840px minimum, inside a horizontal scroller. The stacked form
 * this replaces turned a matrix into five lists and lost the one thing a matrix is for:
 * you cannot see a hole in a column you are reading one row at a time. The scroller is
 * focusable and labelled, so it is reachable by keyboard rather than by pointer alone.
 *
 * The lit cell: end-to-end-with-AI at Keenai is the only cell that is neither plainly
 * filled nor empty, and it is the only lamp-coloured region on the page. It is where the
 * studio's whole argument and this person's day job are the same fact.
 */
interface Props {
  person: CollectionEntry<'people'>;
  /** COPY.md §6.1's map lead-in. It is the table's caption, so it names the map once. */
  leadIn: string;
}

const { person, leadIn } = Astro.props;
const coverage = person.data.coverage;

if (!coverage) {
  throw new Error(
    `The coverage map needs src/data/people/${person.data.slug}.json to carry a "coverage" block.`,
  );
}

const { surfaces, places } = coverage;

/*
  The map's own arithmetic, asserted rather than assumed: ten of twenty-five cells
  filled, no empty column and no empty row. If a content edit ever empties a row the map
  stops being the figure it is described as, so the build fails instead of the page
  quietly reading differently.
*/
const filledPerSurface = new Map(surfaces.map((surface) => [surface.key, 0]));
let filled = 0;
for (const place of places) {
  if (place.cells.length === 0) {
    throw new Error(`Coverage map: the ${place.company} column has no filled cell.`);
  }
  for (const cell of place.cells) {
    if (!filledPerSurface.has(cell.surface)) {
      throw new Error(`Coverage map: "${cell.surface}" is not one of the five surfaces.`);
    }
    filledPerSurface.set(cell.surface, (filledPerSurface.get(cell.surface) ?? 0) + 1);
    filled += 1;
  }
}
for (const [key, count] of filledPerSurface) {
  if (count === 0) throw new Error(`Coverage map: the "${key}" row has no filled cell.`);
}
if (filled !== 10) {
  throw new Error(`Coverage map: the map is described as ten filled cells; this one has ${filled}.`);
}

const lampSurfaces = surfaces.filter((surface) => surface.lamp);
if (lampSurfaces.length !== 1) {
  throw new Error('Coverage map: the map has exactly one lit row.');
}

function productFor(place: (typeof places)[number], key: string): string | undefined {
  return place.cells.find((cell) => cell.surface === key)?.product;
}
---

<div class="map">
  <p class="map__lead muted" id="map-lead">{leadIn}</p>

  {/*
    `tabindex="0"` on a scroll container is not a stray tab stop: a region that scrolls
    and cannot be reached from the keyboard is unreachable content, and the role and
    label are what make the stop announce itself as something to scroll rather than as a
    control with no name.
  */}
  <div class="map__scroll" role="region" aria-labelledby="map-lead" tabindex="0">
    <table class="map__table">
      <caption class="sr-only">{leadIn}</caption>
      <thead>
        <tr>
          <th scope="col" class="map__corner">
            <span class="sr-only">Surface</span>
          </th>
          {
            places.map((place) => (
              <th scope="col" class="map__place">
                <span class="map__company">{place.company}</span>
                <span class="map__years mono">{place.years}</span>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          surfaces.map((surface) => (
            <tr data-lamp={surface.lamp ? '' : undefined}>
              <th scope="row" class="map__surface">
                {surface.label}
              </th>
              {
                places.map((place) => {
                  const product = productFor(place, surface.key);
                  return (
                    <td class="map__cell" data-filled={product ? '' : undefined}>
                      {product ? (
                        <span class="map__product">{product}</span>
                      ) : (
                        <span class="sr-only">No product to name.</span>
                      )}
                    </td>
                  );
                })
              }
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

<style>
  .map__lead {
    max-inline-size: 56ch;
    margin-block-end: var(--space-24);
  }

  .map__scroll {
    overflow-x: auto;
    /* A scroll container is a scroll container in every direction unless it is told
       otherwise; the map only ever scrolls sideways. */
    overflow-y: hidden;
    padding-block-end: var(--space-8);
  }

  .map__table {
    inline-size: 100%;
    min-inline-size: 840px;
    border-collapse: separate;
    border-spacing: var(--space-8);
    table-layout: fixed;
    text-align: start;
  }

  .map__corner {
    inline-size: 130px;
  }

  .map__place {
    vertical-align: bottom;
    padding-block-end: var(--space-8);
    display: table-cell;
  }

  .map__company {
    display: block;
    font-size: var(--step-caption);
    font-weight: 600;
  }

  .map__years {
    display: block;
    margin-block-start: var(--space-4);
    font-size: var(--step-micro);
    color: var(--dim);
  }

  .map__surface {
    inline-size: 130px;
    font-size: var(--step-caption);
    font-weight: 400;
    color: var(--dim);
    vertical-align: middle;
    padding-inline-end: var(--space-8);
  }

  .map__cell {
    block-size: 62px;
    padding: var(--space-8);
    border-radius: var(--r-cell);
    vertical-align: middle;
  }

  /* An empty cell is a dashed outline and nothing inside it. It is not a mistake and it
     is not a "no": it is the absence of a product this site can name. */
  .map__cell:not([data-filled]) {
    outline: 1px dashed var(--line);
    outline-offset: -1px;
  }

  .map__cell[data-filled] {
    background: var(--fill);
    border: 1px solid var(--line-2);
  }

  .map__product {
    font-size: 12.5px;
    line-height: 1.35;
    color: var(--ink);
  }

  /*
    The one lit cell. It is the intersection of the surface this studio sells and the
    employer that pays for it, so it is the only cell on the page that is emphasised at
    all — a lamp border, a lamp wash, and a halo that lifts it off the grid without
    making it a second colour.
  */
  tr[data-lamp] .map__cell[data-filled] {
    border: 2px solid var(--lamp);
    background: rgba(var(--lamp-rgb), 0.14);
    box-shadow: 0 0 0 6px rgba(var(--lamp-rgb), 0.07);
  }

  tr[data-lamp] .map__cell[data-filled] .map__product {
    font-weight: 600;
  }

  tr[data-lamp] .map__surface {
    color: var(--lamp);
  }

  /* On paper the table keeps its shape — a table is not a layout column — but the
     scroller is meaningless, so it releases its own minimum. */
  @media print {
    .map__scroll {
      overflow: visible;
    }

    .map__table {
      min-inline-size: 0;
    }
  }
</style>
