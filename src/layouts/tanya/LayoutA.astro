---
import type { CollectionEntry } from 'astro:content';
import WorkCard from '../../components/person/WorkCard.astro';

/**
 * The shared core — Tanya's page's centre, and the structural counterpart to the
 * coverage map on Sahib's.
 *
 * **The two person pages are not the same page with different names in it.** His
 * evidence is breadth, so his centre is a matrix; hers is how the work is put together,
 * so her centre is an architecture. Cloning his layout onto her page would print the one
 * thing about her that is not true.
 *
 * **The page's own layout IS a KMP architecture.** One central column is the shared
 * core; two flanking columns are the native edges, Android on the left, iOS on the
 * right. Content sits in the column that owns it: anything shared sits in the core,
 * anything platform-specific sits on an edge, narrower and quieter. The core is a glass
 * panel running the band's full height, so it reads as a spine rather than as a stack.
 *
 * **Motive appears on more than one layer, and that is the argument rather than a
 * duplication bug.** The card lives in the core, where the KMP work is; an annotation on
 * the iOS edge names the same product arriving on the platform that consumes the shared
 * modules.
 *
 * The DOM order is CORE, Android edge, iOS edge, at every width — the order a screen
 * reader reads, and the order the columns collapse into when the band is too narrow to
 * hold three.
 */
interface Props {
  person: CollectionEntry<'people'>;
  work: {
    heading: string;
    coreStatement: string;
    gatesLink: string;
    body: string;
  };
  /** COPY.md §2.3's `Owns` field label and that person's own gate list. */
  owns: { label: string; line: string };
}

const { person, work, owns } = Astro.props;

const roles = person.data.workHistory;
const core = roles.filter((role) => role.layer === 'core');
const android = roles.filter((role) => role.layer === 'android');
const iosEdge = person.data.edgeAnnotations.filter((note) => note.layer === 'ios');
const androidEdgeNotes = person.data.edgeAnnotations.filter((note) => note.layer === 'android');

if (core.length === 0 || android.length === 0) {
  throw new Error(
    'The shared core needs every role in src/data/people/tanya-jain.json to carry a `layer`, with at least one in the core and one on the Android edge.',
  );
}

/*
  The three structural labels. They are the layout's own names for its three fields,
  which is why they are here and not in COPY.md: the words `Android` and `iOS` are
  shorter, clearer and cheaper than any icon, and with one company on more than one layer
  the edge labels carry a real distinction an icon would blur.
*/
const FIELD_LABELS = { android: 'Android', core: 'Shared core', ios: 'iOS' } as const;

/*
  "One company, three layers" has to be legible without reading a word, so an edge
  annotation prints the company it comes out of. Where the annotation's own label already
  names that company it is not printed a second time; nothing else on this site names a
  thing twice in one mark.
*/
const namesCompany = (note: { fromCompany: string; label: string }) =>
  !note.label.includes(note.fromCompany);

const gates = owns.line
  .split(/,\s*/)
  .map((part) => part.trim())
  .filter(Boolean);
---

<section class="section core-band" aria-label={work.heading}>
  <div class="shell core-band__grid">
    <div class="glass core" data-rv>
      <p class="micro core__label">{FIELD_LABELS.core}</p>
      <h2 class="core__heading">{work.heading}</h2>
      <p class="core__statement">{work.coreStatement}</p>

      <ul class="core__cards">
        {
          core.map((role) => (
            <li>
              <WorkCard entry={role} index={0} />
            </li>
          ))
        }
      </ul>

      <p class="core__body muted">{work.body}</p>

      <div class="core__gates">
        <p class="micro core__gates-label">{owns.label}</p>
        <ul class="core__gates-line">
          {gates.map((gate) => <li>{gate}</li>)}
        </ul>
      </div>
    </div>

    <div class="edge edge--android" data-rv>
      <p class="micro edge__label">{FIELD_LABELS.android}</p>
      {
        androidEdgeNotes.map((note) => (
          <p class="edge__note">
            {namesCompany(note) && <span class="edge__note-company">{note.fromCompany}</span>}
            {note.label}
          </p>
        ))
      }
      <ul class="edge__cards">
        {
          android.map((role, index) => (
            <li>
              <WorkCard entry={role} index={index + 1} />
            </li>
          ))
        }
      </ul>
    </div>

    <div class="edge edge--ios" data-rv>
      <p class="micro edge__label">{FIELD_LABELS.ios}</p>
      {
        iosEdge.map((note) => (
          <p class="edge__note">
            {namesCompany(note) && <span class="edge__note-company">{note.fromCompany}</span>}
            {note.label}
          </p>
        ))
      }
    </div>

    <p class="core-band__gates-link">{work.gatesLink}</p>
  </div>
</section>

<style>
  /*
    Three fields. The core is the widest, because it is the one everything else agrees
    on; the edges are narrower, because that is the claim — the platform code at the
    edges stays small because the core settled it first. The grid says so before a word
    of the copy does.
  */
  .core-band__grid {
    display: grid;
    gap: var(--gap-col);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }

  @media (min-width: 1000px) {
    .core-band__grid {
      grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) minmax(0, 3fr);
    }

    /* Source order is core, Android, iOS — the order it is read in. Placement puts the
       core between its two edges without moving a line of the DOM. */
    .core {
      grid-column: 2;
      grid-row: 1;
    }

    .edge--android {
      grid-column: 1;
      grid-row: 1;
    }

    .edge--ios {
      grid-column: 3;
      grid-row: 1;
    }

    .core-band__gates-link {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  .core {
    padding: var(--space-28);
    /* The one accent edge on the page: the core's top cap. It is where the spine
       starts. */
    border-block-start: 3px solid var(--accent);
  }

  .core__label,
  .edge__label {
    color: var(--dim);
    margin-block-end: var(--space-12);
  }

  .core__statement {
    margin-block-start: var(--space-16);
    color: var(--ink-2);
    max-inline-size: 60ch;
  }

  .core__cards {
    margin-block-start: var(--space-32);
    list-style: none;
    display: grid;
    gap: var(--space-20);
  }

  .core__body {
    margin-block-start: var(--space-32);
    max-inline-size: 62ch;
    font-size: var(--step-small);
    line-height: var(--step-small-lh);
  }

  .core__gates {
    margin-block-start: var(--space-32);
    padding-block-start: var(--space-20);
    border-block-start: 1px solid var(--line);
  }

  .core__gates-label {
    color: var(--lamp);
  }

  .core__gates-line {
    margin-block-start: var(--space-12);
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .core__gates-line li {
    padding: var(--space-8) var(--space-14);
    border-radius: var(--r-pill);
    border: 1px solid var(--line);
    background: var(--card);
    font-size: var(--step-caption);
    color: var(--ink);
  }

  /*
    An edge is indented behind a rule rather than fenced in a panel, so it reads as
    something hanging off the core rather than as a third object of the same weight. At
    one column the rule is what preserves the structure: depth, not horizontal position.
  */
  .edge {
    padding-inline-start: var(--space-20);
    border-inline-start: 2px solid var(--line-2);
  }

  .edge__note {
    color: var(--dim);
    font-size: var(--step-small);
    line-height: var(--step-small-lh);
    margin-block-end: var(--space-16);
  }

  .edge__note-company {
    display: block;
    color: var(--ink);
    font-weight: 600;
  }

  .edge__cards {
    list-style: none;
    display: grid;
    gap: var(--space-20);
  }

  .core-band__gates-link {
    margin-block-start: var(--space-32);
    max-inline-size: 62ch;
    color: var(--dim);
    font-size: var(--step-small);
    line-height: var(--step-small-lh);
  }
</style>
