---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { SKIP_LINK } from '../lib/copy';

interface Props {
  /** COPY.md's meta title for the route. */
  title: string;
  /** COPY.md's meta description for the route. */
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  /** PLAN.md §1.2 — one attribute picks which token set is live. */
  world?: 'studio' | 'sahib' | 'tanya';
  noindex?: boolean;
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  world = 'studio',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

/**
 * DESIGN.md §I item 4 — `theme-color` ships as two entries keyed to
 * `prefers-color-scheme`. It cannot follow a visitor's *stored* override, which is a
 * known and accepted mismatch, recorded there rather than discovered here. Values are
 * each world's own page ground in each scheme (§B.2, §B.2a, §F.4, §F.4a, §G.1, §G.1a).
 */
const THEME_COLOR = {
  studio: { light: '#F1F3F0', dark: '#18292D' },
  sahib: { light: '#EEEFF4', dark: '#161C2E' },
  tanya: { light: '#EDEEEE', dark: '#191B1B' },
} as const;
const themeColor = THEME_COLOR[world];
---

<!doctype html>
<html lang="en" data-world={world}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      DESIGN.md §B.10a — the stored choice must be applied before first paint, because
      the floor band must never be seen in the wrong scheme. This runs in <head>,
      ahead of the stylesheet link, so the first paint is already correct. No stored
      choice follows prefers-color-scheme; no stored choice and no expressed OS
      preference falls back to light, which is also the print scheme.
      `data-theme` is always set explicitly, never left absent: Sahib's world inverts
      and reads [data-theme="light"] as its override scope (§F.4a).
    -->
    <script is:inline>
      (function () {
        var scheme = 'light';
        try {
          var stored = localStorage.getItem('tgd-theme');
          if (stored === 'light' || stored === 'dark') {
            scheme = stored;
          } else if (
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: dark)').matches
          ) {
            scheme = 'dark';
          }
        } catch (error) {
          scheme = 'light';
        }
        document.documentElement.setAttribute('data-theme', scheme);
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <!--
      DESIGN.md §B.12 — four files, all exported from `public/favicon.svg` by
      `npm run icons`. The SVG is the primary icon everywhere it is supported; the 32px
      PNG is the fallback and downsamples cleanly to 16, which is why the geometry is
      authored on a 32 grid. No .ico, no 16px PNG, no maskable variant. The mark itself
      never appears on a page — if it ever renders in the layout it has become a logo.
    -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="theme-color" content={themeColor.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={themeColor.dark} media="(prefers-color-scheme: dark)" />

    <!-- PLAN.md §1.5 — only the hero face is preloaded. Nothing else. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/anek-latin-latin-standard-normal.woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TheGeekDogs" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta name="twitter:card" content="summary" />

    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">{SKIP_LINK}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
