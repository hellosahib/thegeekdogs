---
import { getEntry } from 'astro:content';
import PrivacyPolicyPage from '../../../components/PrivacyPolicyPage.astro';

/*
  `/work/wedding-planner/privacy/`. The URL Google Play Console is given.

  The route is descriptive, like every other reference to this product on the site: it
  sits under the product's existing slug rather than under a name. The owner has settled a
  name for the STORE LISTING, which is a different decision from committing that name to
  this site's public URLs while COPY.md §5 still says nothing here names it. QUESTIONS.md
  item 78 puts the question to the owners; until it is answered the least-committal honest
  route is the one that already exists.

  A store URL is permanent in practice — a console field that has been submitted is read
  by reviewers and by users, and moving it later means a redirect that has to be
  maintained. That is an argument for the route NOT carrying a name that is still open.
*/
const product = await getEntry('products', 'wedding-planner');
if (!product) throw new Error('src/data/products/wedding-planner.json is missing.');
---

<PrivacyPolicyPage product={product} />
