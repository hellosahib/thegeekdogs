---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StageTrack from '../../components/StageTrack.astro';
import { WORK_INDEX } from '../../lib/copy';
import { workIndexGraph } from '../../lib/jsonld';

/*
  Two entries, each a glass panel: the product name, the full labelled build-stage track,
  and the link into its own page. No hero image, and no second description — the name and
  its stage say enough on an index, and the entry has one job per row.

  The five-stage track is the primary device here, and it is the SAME component the home
  page's proof panel and both product pages use. A visitor who learned to read it on the
  home page has already learned to read this page.

  COPY.md §3.1 gives a short intro and a long body and says the short one is what prints
  if only one can, so the short intro prints and the long body is not placed.
*/
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const schema = await workIndexGraph();

if (products.length === 0) {
  throw new Error('/work/ has no products; src/data/products must carry both entries.');
}
---

<BaseLayout
  title={WORK_INDEX.meta.title}
  description={WORK_INDEX.meta.description}
  ogTitle={WORK_INDEX.meta.ogTitle}
  ogDescription={WORK_INDEX.meta.ogDescription}
  ogImage="work"
  schema={schema}
>
  <section class="section work-section">
    <div class="shell">
      <div class="work-intro">
        <p class="eyebrow accent">Work</p>
        <h1 class="work-intro__headline">{WORK_INDEX.headline}</h1>
        <p class="lede work-intro__line">{WORK_INDEX.intro}</p>
      </div>

      <ul class="work-list">
        {
          products.map((product) => (
            <li class="glass work-entry" data-rv>
              <h2 class="work-entry__name">{product.data.indexName}</h2>
              <div class="work-entry__track">
                {/* The card's own h2 has just named the product; the track does not
                    name it a second time. */}
                <StageTrack stage={product.data.stage} label={product.data.descriptiveName} showName={false} />
              </div>
              <p class="work-entry__links cluster">
                <a
                  class="link-row"
                  href={`/work/${product.data.slug}/`}
                  aria-label={product.data.indexLink.accessibleName}
                >
                  {product.data.indexLink.label}
                </a>
                {
                  product.data.storeUrl && product.data.indexStoreLabel && (
                    <a
                      class="link-row"
                      href={product.data.storeUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {product.data.indexStoreLabel}
                      <span class="sr-only"> Opens a new tab.</span>
                    </a>
                  )
                }
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .work-section {
    flex: 1 0 auto;
  }

  .work-intro__headline {
    margin-block-start: var(--space-14);
    max-inline-size: 18ch;
  }

  .work-intro__line {
    margin-block-start: var(--space-24);
    max-inline-size: 56ch;
  }

  .work-list {
    margin-block-start: var(--gap-block);
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: var(--gap-col);
    align-items: start;
  }

  .work-entry {
    padding: var(--space-28);
  }

  .work-entry__name {
    font-size: var(--step-card-title);
  }

  .work-entry__track {
    margin-block-start: var(--space-28);
  }

  .work-entry__links {
    margin-block-start: var(--space-28);
    column-gap: var(--space-24);
  }
</style>
