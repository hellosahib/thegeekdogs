---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StageTrack from '../components/StageTrack.astro';
import StudioFloor from '../components/floor/StudioFloor.astro';
import WorkCardStrip from '../components/WorkCardStrip.astro';
import { STUDIO_EMAIL, CONTACT_AFFORDANCE, FINAL_CTA } from '../lib/copy';
import { studioGraph } from '../lib/jsonld';
import { FLOOR_ALT } from '../lib/floor';

/*
  COPY.md §2, in section order: hero, the floor, where they've worked, the four gates,
  proof, what you get, the final CTA.

  Three headline variants exist and only one ships. The two alternates are recorded in
  the design handoff so the studio can swap without re-deriving them; the live one is
  below, and it is the one the prototype's default state carries.
*/

const gates = (await getCollection('gates')).sort((a, b) => a.data.order - b.data.order);

const pocketManager = await getEntry('products', 'pocket-manager');
const weddingPlanner = await getEntry('products', 'wedding-planner');

if (!pocketManager || !weddingPlanner) {
  throw new Error('Both products must exist in src/data/products before / can render.');
}

const runners = [pocketManager, weddingPlanner].map((product) => ({
  label: product.data.descriptiveName,
  stage: product.data.stage,
}));

const storeUrl = pocketManager.data.storeUrl;

/*
  The three figures, COPY.md §2.7's own ("4.3 stars from 24 reviews, 1,000+ downloads"),
  split at the word boundary. No figure and no label is written here.

  The two countable figures are asserted against the store entry so the block and the
  content collection cannot drift. `downloads` is a display string and the two documents
  round it differently — COPY.md §2.7 prints `1,000+`, the store listing's own rounding
  in src/data/products is `1K+` — so COPY.md's is what prints.
*/
const stats = pocketManager.data.storeStats;
if (!stats || stats.rating !== 4.3 || stats.ratingCount !== 24) {
  throw new Error(
    "Pocket Manager's store stats no longer match COPY.md §2.7's figures; the proof block must be re-transcribed.",
  );
}
const schema = await studioGraph();

const figures = [
  { figure: '4.3', label: 'stars' },
  { figure: '24', label: 'reviews' },
  { figure: '1,000+', label: 'downloads' },
];
---

<BaseLayout
  title="TheGeekDogs, a two-person mobile studio"
  description="Two-person mobile studio. Agents write most of the build; a person reviews the architecture, tests on real phones, and signs off before anything ships."
  ogTitle="AI writes a lot of our code. It doesn't get the last word."
  ogDescription="A two-person mobile studio with four human gates between the code and your users. Pocket Manager is live in the Play Store."
  ogImage="home"
  ogImageAlt={FLOOR_ALT}
  schema={schema}
>
  <section class="hero" data-hero>
    {/*
      The cursor glow: two stacked radials on one centre, the orchid halo wide and the
      brass core tight inside it, so the light has a temperature rather than just a
      radius. The centre is two custom properties written on the section from a
      pointermove handler and eased home on leave. It is decorative and inert.
    */}
    <span class="hero__glow" aria-hidden="true"></span>

    <div class="shell hero__inner">
      <p class="eyebrow hero__eyebrow accent">Two-person mobile studio · Bengaluru</p>
      <h1 class="hero__title">
        <span class="hero__line">AI writes a lot of our code.</span>
        <span class="hero__line hero__line--2">It doesn't get the last word.</span>
      </h1>
      <p class="lede hero__lede">
        A two-person mobile studio. Agents do the volume work. Then a person reviews the
        architecture, tests on real phones, and signs off on security.
      </p>
      <p class="cluster hero__actions">
        <a
          class="pill pill--accent"
          data-cta="hero-primary"
          href={`mailto:${STUDIO_EMAIL}`}
          aria-label={CONTACT_AFFORDANCE.accessibleName}
        >
          {CONTACT_AFFORDANCE.label}
        </a>
        <a class="pill pill--ghost" href="#studio-floor" aria-label="Look around the studio floor">
          Look around the floor
        </a>
      </p>
    </div>
  </section>

  <StudioFloor />

  <WorkCardStrip />

  <section class="section raised gates-section" data-theme-anim>
    <div class="shell gates-section__grid">
      <div class="gates-section__lead" data-rv>
        <h2>Four things we don't hand to an agent.</h2>
        <p class="gates-section__extra muted">
          Design review and the release itself stay with Sahib and Tanya: both read the
          layouts before build, and both names go on every release.
        </p>
        <p class="quote gates-section__quote">
          That's the difference between generated software and shipped software.
        </p>
      </div>

      <ol class="gates" data-rv>
        {
          gates.map((gate, i) => (
            <li
              class="glass gates__item"
              data-lift
              style={`--tilt:${i % 2 === 0 ? '-0.4' : '0.4'}deg`}
            >
              <p class="gates__no mono accent">{String(i + 1).padStart(2, '0')}</p>
              <h3>{gate.data.name}</h3>
              <p class="gates__body muted">{gate.data.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section proof">
    <div class="shell proof__grid">
      <div class="proof__lead" data-rv>
        <p class="eyebrow accent">Proof</p>
        <h2 class="proof__title">We run this on our own app first.</h2>
        <p class="muted proof__body">
          Pocket Manager has been in the Play Store since 2020, maintained by the same pipeline
          and the same review gates. 4.3 stars from 24 reviews, 1,000+ downloads, and it still
          gets updates five years on.
        </p>

        <ul class="figures">
          {
            figures.map((item) => (
              <li class="card figures__item">
                {/*
                  `data-count` counts the number the page ALREADY PRINTS: the element's
                  own text is the source, so the figure is right before the script runs,
                  right if it never runs, and right for a reader who has motion turned
                  off.
                */}
                <span class="figures__figure numeral" data-count>
                  {item.figure}
                </span>
                <span class="figures__label micro muted">{item.label}</span>
              </li>
            ))
          }
        </ul>

        <p class="muted proof__body">
          A second app sits behind it in final touches, built through the same pipeline and
          stopped at the same gates. There's no date on it. The list of what's left is short,
          and a person decides when it ends.
        </p>

        <p class="cluster proof__links">
          {
            storeUrl && (
              <a class="link-row" href={storeUrl} target="_blank" rel="noopener noreferrer">
                Open Pocket Manager in the Play Store
                <span class="sr-only"> Opens a new tab.</span>
              </a>
            )
          }
          <a class="link-row" href="/work/pocket-manager/">Read how it gets built</a>
        </p>
      </div>

      <div class="glass proof__panel" data-rv>
        <p class="micro muted proof__panel-label">One shipped, one nearly there</p>
        {runners.map((runner) => <StageTrack label={runner.label} stage={runner.stage} />)}
        <p class="caption muted proof__note">
          The track shows both products and where each one actually is: Pocket Manager shipped
          and still updated, the second one close enough that the list of what's left is short.
          Neither carries a date, and neither will. A date we miss in public is worse than no
          date at all.
        </p>
      </div>
    </div>
  </section>

  <section class="section offer">
    <div class="shell offer__inner" data-rv>
      <h2>You'll be holding something before you're bored of the kickoff.</h2>
      <p class="muted">
        The first thing we hand over is a working build you can open on your phone. Not a
        deck, not a Figma walkthrough, not a status update. Everything after that is
        iteration on a thing that already runs.
      </p>
      <p class="muted">
        One project at a time. Fixed scope or a retainer, both work here. It starts with a
        short written brief rather than a call, and a first MVP is a few days from the
        go-ahead.
      </p>
    </div>
  </section>

  <section class="room cta" data-theme-anim>
    {/* A warm radial rising off the bottom edge, so the page ends on the same light the
        room is lit by rather than on a flat black. */}
    <span class="cta__glow" aria-hidden="true"></span>
    <div class="shell cta__inner" data-rv>
      {/* The title first, then the sentence that answers it. Reversed, "One email, a real
          reply…" reads as a kicker above the heading rather than as its answer. */}
      <h2 class="cta__title">Tell us what you're building.</h2>
      <p class="lede cta__body">
        One email, a real reply from one of us, and a straight answer about whether we're the
        right fit. If we're not, we'll say so.
      </p>
      <p>
        {/*
          Accent-filled, not lamp-filled. The lamp is reserved for light sources and live
          state, and a call to action is neither.
        */}
        <a
          class="pill pill--accent pill--lg cta__address"
          data-cta="final-cta"
          href={`mailto:${STUDIO_EMAIL}`}
          aria-label={FINAL_CTA.accessibleName}
        >
          {FINAL_CTA.label}
        </a>
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  /*
    The hero's light follows the pointer. Two custom properties, written on the section,
    so the paint is a compositor-side gradient move; nothing measures layout per event
    except the one bounding rect, which is read from the section the handler is bound to.

    On leave the centre eases back to its resting point rather than snapping, because a
    light that jumps when you look away reads as a bug rather than as a light.
  */
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    hero.addEventListener('pointermove', (event: PointerEvent) => {
      const r = hero.getBoundingClientRect();
      hero.style.setProperty('--hx', `${((event.clientX - r.left) / r.width) * 100}%`);
      hero.style.setProperty('--hy', `${((event.clientY - r.top) / r.height) * 100}%`);
      hero.style.setProperty('--hero-ease', '0s');
    });
    hero.addEventListener('pointerleave', () => {
      hero.style.setProperty('--hero-ease', '.5s');
      hero.style.setProperty('--hx', '50%');
      hero.style.setProperty('--hy', '38%');
    });
  }
</script>

<style>
  /* --- Hero --- */

  .hero {
    position: relative;
    padding-block: var(--hero-pad-top) var(--hero-pad-bottom);
    overflow: hidden;
  }

  .hero__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: background-position var(--hero-ease, 0s) ease;
    background:
      radial-gradient(620px circle at var(--hx, 50%) var(--hy, 38%), var(--halo), transparent 68%),
      radial-gradient(320px circle at var(--hx, 50%) var(--hy, 38%), var(--halo-2), transparent 62%);
  }

  .hero__inner {
    position: relative;
  }

  /*
    The hero's four elements rise in sequence rather than fading in together. The stagger
    is what makes the second line land as an answer to the first: 0 / .1 / .26 / .42 /
    .56s, which is slow enough to read as deliberate and short enough to be over before
    a reader has finished the eyebrow.
  */
  .hero__eyebrow {
    margin-block-end: clamp(20px, 2.4vw, 32px);
    animation: riseline 0.7s var(--ease-out) both;
  }

  .hero__title {
    max-inline-size: 19ch;
  }

  .hero__line {
    display: block;
    animation: riseline 0.9s var(--ease-out) 0.1s both;
  }

  /* The second line is the argument, and it is set in --dim: the studio concedes the
     first sentence and only then takes it back. */
  .hero__line--2 {
    color: var(--dim);
    animation-delay: 0.26s;
  }

  .hero__lede {
    margin-block-start: clamp(24px, 3vw, 40px);
    max-inline-size: 56ch;
    animation: riseline 0.9s var(--ease-out) 0.42s both;
  }

  .hero__actions {
    margin-block-start: clamp(28px, 3.4vw, 44px);
    animation: riseline 0.9s var(--ease-out) 0.56s both;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__eyebrow,
    .hero__line,
    .hero__lede,
    .hero__actions {
      animation: none;
    }

    .hero__glow {
      transition: none;
    }
  }

  /* --- The four gates --- */

  .gates-section__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--gap-col);
    align-items: start;
  }

  .gates-section__extra {
    margin-block-start: var(--space-24);
    max-inline-size: 46ch;
  }

  .gates-section__quote {
    margin-block-start: var(--space-32);
    max-inline-size: 20ch;
  }

  .gates {
    list-style: none;
    display: grid;
    gap: var(--space-16);
  }

  .gates__item {
    padding: var(--space-24);
  }

  .gates__no {
    font-size: var(--step-caption);
    letter-spacing: var(--step-mono-tracking);
    margin-block-end: var(--space-12);
  }

  .gates__body {
    margin-block-start: var(--space-8);
    font-size: var(--step-small);
    line-height: var(--step-small-lh);
  }

  /* --- Proof --- */

  .proof__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: var(--gap-col);
    align-items: start;
  }

  .proof__title {
    margin-block-start: var(--space-14);
  }

  .proof__body {
    margin-block-start: var(--space-24);
    max-inline-size: 54ch;
  }

  .proof__links {
    margin-block-start: var(--space-24);
    column-gap: var(--space-32);
  }

  .figures {
    list-style: none;
    margin-block-start: var(--space-32);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 120px), 1fr));
    gap: var(--space-12);
  }

  .figures__item {
    border-radius: var(--r-tile);
    padding: var(--space-16);
    display: grid;
    gap: var(--space-8);
  }

  .figures__figure {
    font-size: var(--step-figure);
    line-height: var(--step-figure-lh);
    letter-spacing: var(--step-figure-tracking);
    color: var(--ink);
  }

  .proof__panel {
    padding: var(--space-28);
    display: grid;
    gap: var(--space-32);
  }

  .proof__panel-label {
    margin-block-end: calc(-1 * var(--space-16));
  }

  .proof__note {
    color: var(--dim);
  }

  /* --- What you get --- */

  /*
    Left-aligned on the page's own edge, not centred. Centred, this was the only block on
    the site whose left edge was not the gutter — its h2 began 347px right of the CTA h2
    directly beneath it, with nothing establishing the second axis.
  */
  .offer__inner {
    max-inline-size: 62ch;
    display: grid;
    gap: var(--space-24);
  }

  /* --- Closing --- */

  .cta {
    position: relative;
    padding-block: var(--cta-pad);
    overflow: hidden;
  }

  .cta__glow {
    position: absolute;
    inset-inline: 0;
    inset-block-end: -30%;
    block-size: 90%;
    pointer-events: none;
    background: radial-gradient(60% 100% at 50% 100%, var(--halo-2), transparent 70%);
  }

  .cta__inner {
    position: relative;
    display: grid;
    gap: var(--space-24);
    justify-items: start;
  }

  .cta__body {
    max-inline-size: 56ch;
  }

  .cta__title {
    max-inline-size: 18ch;
    /* A step down from the section scale: at the full 50px this line wraps to three, and
       it is the last thing on the page rather than the loudest. */
    font-size: clamp(26px, 2.8vw, 38px);
  }

  /* An address is an address, on this page as on both person pages. It was the one
     address on the site not set in the mono face. */
  .cta__address {
    font-family: var(--tgd-font-mono);
  }
</style>
