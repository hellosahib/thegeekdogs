---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CONTACT } from '../../lib/copy';
import { studioGraph } from '../../lib/jsonld';

/*
  Three addressed blocks and no form: email only, so there is no field, no endpoint, no
  success state and no validation design on this page. All three addresses print in full
  as `mailto:` links over the visible address, never a label over a hidden one.

  There is no orchestrated moment here. A contact page's job is to be answered.
*/
const schema = await studioGraph();
---

<BaseLayout
  title={CONTACT.meta.title}
  description={CONTACT.meta.description}
  ogTitle={CONTACT.meta.ogTitle}
  ogDescription={CONTACT.meta.ogDescription}
  ogImage="contact"
  schema={schema}
>
  <section class="section contact-intro">
    <div class="shell contact-intro__grid">
      <div>
        <p class="eyebrow accent">Contact</p>
        <h1 class="contact-intro__headline">{CONTACT.headline}</h1>
      </div>
      <p class="lede contact-intro__body">{CONTACT.body}</p>
    </div>
  </section>

  <section class="section raised routes-section" data-theme-anim>
    <div class="shell">
      <h2 class="routes__heading" data-rv>{CONTACT.routesHeading}</h2>
      <ul class="routes">
        {
          CONTACT.routes.map((route, i) => (
            <li
              class="glass routes__item"
              data-lift
              data-rv
              style={`--tilt:${i % 2 === 0 ? '-0.4' : '0.4'}deg`}
            >
              <h3 class="routes__label">{route.label}</h3>
              <p class="routes__line muted">{route.line}</p>
              <p class="routes__address">
                <a class="routes__link mono" href={`mailto:${route.address}`}>
                  {route.address}
                </a>
              </p>
            </li>
          ))
        }
      </ul>
      <p class="routes__engagement muted" data-rv>{CONTACT.engagementLine}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-intro__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--gap-col);
    align-items: end;
  }

  .contact-intro__headline {
    margin-block-start: var(--space-14);
    max-inline-size: 16ch;
  }

  .contact-intro__body {
    max-inline-size: 58ch;
  }

  .routes-section {
    flex: 1 0 auto;
  }

  .routes__heading {
    font-size: var(--step-subsection);
  }

  .routes {
    margin-block-start: var(--gap-block);
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--gap-col);
    align-items: stretch;
  }

  .routes__item {
    padding: var(--space-24);
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .routes__label {
    font-size: var(--step-card-title);
  }

  .routes__line {
    font-size: var(--step-small);
    line-height: var(--step-small-lh);
  }

  /* The address is the card's affordance, so it sits at its foot, in the accent, in the
     mono face — an address is an address. */
  .routes__address {
    margin-block-start: auto;
    padding-block-start: var(--space-16);
    border-block-start: 1px solid var(--line);
  }

  .routes__link {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    color: var(--accent);
    font-size: var(--step-small);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    /* An address is one word to a reader and it must not break mid-domain, but it also
       must not push the card wider than its column. */
    overflow-wrap: anywhere;
  }

  .routes__engagement {
    margin-block-start: var(--gap-block);
    max-inline-size: 66ch;
  }
</style>
