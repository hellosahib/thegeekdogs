---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuietBack from '../../components/person/QuietBack.astro';
import HeadshotSlot from '../../components/person/HeadshotSlot.astro';
import WorkCard from '../../components/person/WorkCard.astro';
import PersonLinks from '../../components/person/PersonLinks.astro';
import CoverageMap from '../../components/sahib/CoverageMap.astro';
import { SAHIB } from '../../lib/copy';
import { personGraph } from '../../lib/jsonld';

/*
  The page's job is one claim: the delivery model this studio sells is how he already
  works. The map is the argument, the cards are the footnotes, and the CV order survives
  only inside the footnotes.

  COPY.md §6 is the only source of prose here. The section labels the old wireframes drew
  — `Where he has shipped`, `Seven years, four companies` — were wireframe labels rather
  than COPY.md strings, so the map is named by §6.1's own lead-in and the cards by
  §6.2's.
*/
const person = await getEntry('people', 'sahib-singh');
if (!person) throw new Error('/sahib/ needs src/data/people/sahib-singh.json.');

/*
  COPY.md §6.3's body is one paragraph and four of its phrases are its link text, in the
  order the body names them: "Four subjects, four links, or none of them link." This
  asserts that the runs stored in copy.ts still reassemble into that paragraph, so a
  future edit to either cannot silently produce a different sentence.
*/
const writingParagraph =
  SAHIB.writing.lead +
  SAHIB.writing.links.map((link) => link.text + link.after).join('') +
  SAHIB.writing.tail;
if (!writingParagraph.startsWith('Sahib writes Android posts regularly and they land: ')) {
  throw new Error("COPY.md §6.3's body no longer reassembles from its four linked runs.");
}

const schema = await personGraph(person);
---

<BaseLayout
  title={SAHIB.meta.title}
  description={SAHIB.meta.description}
  ogTitle={SAHIB.meta.ogTitle}
  ogDescription={SAHIB.meta.ogDescription}
  ogImage="sahib"
  schema={schema}
  footerLinks
>
  <section class="section person-hero">
    <div class="shell">
      <QuietBack />

      <div class="person-hero__grid">
        <div class="person-hero__words">
          <p class="eyebrow accent">Architecture review · Code review · Release cut</p>
          <h1 class="person-hero__title">{person.data.name}</h1>
          <p class="lede person-hero__lede">{SAHIB.roleLine}</p>
          <PersonLinks person={person} links={SAHIB.links} />
        </div>

        <div class="person-hero__portrait">
          <HeadshotSlot monogram="SS" />
        </div>
      </div>
    </div>
  </section>

  <section class="section positioning">
    <div class="shell" data-rv>
      <p class="positioning__body">{SAHIB.body}</p>
    </div>
  </section>

  <section class="section raised map-section" data-theme-anim>
    <div class="shell" data-rv>
      <h2 class="section-line">{SAHIB.mapSectionLine}</h2>
      <CoverageMap person={person} leadIn={SAHIB.mapLeadIn} />
      <p class="map-section__texture muted">{SAHIB.textureLine}</p>
    </div>
  </section>

  <section class="section cards-section">
    <div class="shell" data-rv>
      <h2 class="section-line">{SAHIB.cardsSectionLine}</h2>
      <ul class="cards">
        {
          person.data.workHistory.map((role, index) => (
            <li>
              <WorkCard entry={role} index={index} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section room writing-section" data-theme-anim>
    <div class="shell writing__grid">
      <div data-rv>
        <h2>{SAHIB.writing.heading}</h2>
        <p class="writing__body muted">
          {SAHIB.writing.lead}
          {
            SAHIB.writing.links.map((link) => (
              <>
                <a class="link" href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.text}
                  <span class="sr-only"> Opens a new tab.</span>
                </a>
                {link.after}
              </>
            ))
          }
          {SAHIB.writing.tail}
        </p>
        <p class="quote writing__quote">{SAHIB.writing.closingLine}</p>
      </div>

      <div class="glass background" data-rv>
        <h3 class="background__heading micro muted">{SAHIB.background.heading}</h3>
        <ol class="background__list">
          {
            SAHIB.background.items.map((item, i) => (
              <li class="background__item">
                <span class="background__no mono accent">{String(i + 1).padStart(2, '0')}</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section close">
    <div class="shell close__inner" data-rv>
      <h2 class="close__title">Write to Sahib directly.</h2>
      <p>
        <a
          class="pill pill--accent pill--lg close__address"
          href={`mailto:${SAHIB.links.email.address}`}
          aria-label={SAHIB.links.email.accessibleName}
        >
          {SAHIB.links.email.label}
        </a>
      </p>
      <QuietBack />
    </div>
  </section>
</BaseLayout>

<style>
  /* --- Hero --- */

  /*
    Two columns, bottom-aligned, so the h1's baseline and the portrait's lower edge
    settle on the same line rather than the words floating in the middle of a tall frame.
  */
  .person-hero__grid {
    margin-block-start: var(--space-32);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--gap-col);
    align-items: end;
  }

  .person-hero__title {
    margin-block-start: var(--space-16);
    font-size: var(--step-person-hero);
  }

  .person-hero__lede {
    margin-block: var(--space-24) var(--space-32);
    max-inline-size: 44ch;
  }

  /*
    A flex row rather than `justify-self: end` on the grid item. `justify-self` shrinks
    the item to its own content width, and the frame inside it is sized `100%` of that
    item — which is circular, and rendered as a 60px square with the monogram and the
    slot label on top of each other. The item keeps its full column and the frame is
    pushed to the end of it instead.
  */
  .person-hero__portrait {
    display: flex;
    justify-content: flex-end;
  }

  /* --- Positioning --- */

  .positioning {
    padding-block: 0 var(--section-pad);
  }

  .positioning__body {
    max-inline-size: 66ch;
    color: var(--dim);
    font-size: clamp(16px, 1.25vw, 18px);
    line-height: var(--step-lede-lh);
  }

  /* --- The map and the cards --- */

  .section-line {
    font-size: var(--step-subsection);
    margin-block-end: var(--space-24);
  }

  .map-section__texture {
    margin-block-start: var(--space-32);
    max-inline-size: 66ch;
  }

  .cards {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--gap-col);
    align-items: stretch;
  }

  .cards > li {
    display: flex;
  }

  /* --- Writing --- */

  .writing__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--gap-col);
    align-items: start;
  }

  .writing__body {
    margin-block-start: var(--space-24);
    max-inline-size: 58ch;
  }

  .writing__quote {
    margin-block-start: var(--space-32);
    font-size: clamp(18px, 1.7vw, 24px);
    max-inline-size: 34ch;
  }

  .background {
    padding: var(--space-28);
  }

  .background__heading {
    color: var(--dim);
    margin-block-end: var(--space-20);
  }

  .background__list {
    list-style: none;
    display: grid;
    gap: var(--space-16);
  }

  .background__item {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    column-gap: var(--space-16);
    align-items: baseline;
    color: var(--ink-2);
    font-size: var(--step-small);
    line-height: var(--step-small-lh);
  }

  .background__no {
    font-size: var(--step-micro);
    letter-spacing: var(--step-mono-tracking);
  }

  /* --- Close --- */

  .close__inner {
    display: grid;
    gap: var(--space-24);
    justify-items: start;
  }

  .close__address {
    font-family: var(--tgd-font-mono);
  }
</style>
