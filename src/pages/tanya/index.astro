---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuietBack from '../../components/person/QuietBack.astro';
import HeadshotSlot from '../../components/person/HeadshotSlot.astro';
import PersonLinks from '../../components/person/PersonLinks.astro';
import LayoutA from '../../layouts/tanya/LayoutA.astro';
import { TANYA } from '../../lib/copy';
import { personGraph } from '../../lib/jsonld';

/*
  Her axis is the system, not the timeline: nothing on this page is a dated list.

  It mirrors `/sahib/` in structure — a hero with a reserved portrait, a positioning
  paragraph, a centre, the evidence, a background panel, a close — and differs in the one
  place that matters. His centre is a matrix of what he has shipped; hers is the shape
  the work is built in. The two people have different evidence, and the structural
  distinction between their pages is the point rather than an inconsistency.
*/
const person = await getEntry('people', 'tanya-jain');
if (!person) throw new Error('/tanya/ needs src/data/people/tanya-jain.json.');

if (!person.data.ownsLine) {
  throw new Error("The core's gate block needs COPY.md §2.3's gate list on her entry.");
}

const schema = await personGraph(person);
---

<BaseLayout
  title={TANYA.meta.title}
  description={TANYA.meta.description}
  ogTitle={TANYA.meta.ogTitle}
  ogDescription={TANYA.meta.ogDescription}
  ogImage="tanya"
  schema={schema}
  footerLinks
>
  <section class="section person-hero">
    <div class="shell">
      <QuietBack />

      <div class="person-hero__grid">
        <div class="person-hero__words">
          <p class="eyebrow accent">Product spec · Device QA · Security and privacy review</p>
          <h1 class="person-hero__title">{person.data.name}</h1>
          <p class="lede person-hero__lede">{TANYA.roleLine}</p>
          <PersonLinks person={person} links={TANYA.links} />
        </div>

        <div class="person-hero__portrait">
          <HeadshotSlot monogram="TJ" />
        </div>
      </div>
    </div>
  </section>

  <section class="section positioning">
    <div class="shell positioning__inner" data-rv>
      <p class="positioning__body">{TANYA.body}</p>
      <p class="positioning__body">{TANYA.secondParagraph}</p>
    </div>
  </section>

  <section class="section room quotes-section" data-theme-anim>
    <div class="shell quotes__grid">
      <div data-rv>
        {/*
          The only quoted material on the site, and the quotation marks are part of the
          strings: they must read as quotation, not as pull-quote decoration. There is no
          left rule under them for exactly that reason — a rule is the pull-quote
          convention and would say the opposite of what the marks say.
        */}
        {
          TANYA.quotes.map((quote) => (
            <blockquote class="quote quotes__quote">
              <p>{quote}</p>
            </blockquote>
          ))
        }
        <p class="small muted quotes__attribution">
          <cite>{TANYA.quoteAttribution}</cite>
        </p>
      </div>

      <p class="quotes__closing" data-rv>{TANYA.quoteClosingLine}</p>
    </div>
  </section>

  <LayoutA
    person={person}
    work={TANYA.work}
    owns={{ label: 'Owns', line: person.data.ownsLine }}
  />

  <section class="section background-section">
    <div class="shell background__grid">
      <h2 class="background__title" data-rv>{TANYA.background.heading}</h2>
      <div class="glass background" data-rv>
        <ol class="background__list">
          {
            TANYA.background.items.map((item, i) => (
              <li class="background__item">
                <span class="background__no mono accent">{String(i + 1).padStart(2, '0')}</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section close">
    <div class="shell close__inner" data-rv>
      <h2 class="close__title">Write to Tanya directly.</h2>
      <p>
        <a
          class="pill pill--accent pill--lg close__address"
          data-cta="person-cta"
          href={`mailto:${TANYA.links.email.address}`}
          aria-label={TANYA.links.email.accessibleName}
        >
          {TANYA.links.email.label}
        </a>
      </p>
      <QuietBack />
    </div>
  </section>
</BaseLayout>

<style>
  .person-hero__grid {
    margin-block-start: var(--space-32);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--gap-col);
    align-items: end;
  }

  .person-hero__title {
    margin-block-start: var(--space-16);
    font-size: var(--step-person-hero);
  }

  .person-hero__lede {
    margin-block: var(--space-24) var(--space-32);
    max-inline-size: 44ch;
  }

  /*
    A flex row rather than `justify-self: end` on the grid item. `justify-self` shrinks
    the item to its own content width, and the frame inside it is sized `100%` of that
    item — which is circular, and rendered as a 60px square with the monogram and the
    slot label on top of each other. The item keeps its full column and the frame is
    pushed to the end of it instead.
  */
  .person-hero__portrait {
    display: flex;
    justify-content: flex-end;
  }

  .positioning {
    padding-block: 0 var(--section-pad);
  }

  .positioning__inner {
    display: grid;
    gap: var(--space-20);
  }

  .positioning__body {
    max-inline-size: 66ch;
    color: var(--dim);
    font-size: clamp(16px, 1.25vw, 18px);
    line-height: var(--step-lede-lh);
  }

  .quotes__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--gap-col);
    align-items: center;
  }

  .quotes__quote {
    margin: 0;
    max-inline-size: 30ch;
  }

  .quotes__quote + .quotes__quote {
    margin-block-start: var(--space-24);
  }

  .quotes__attribution {
    margin-block-start: var(--space-20);
  }

  .quotes__attribution cite {
    font-style: normal;
  }

  .quotes__closing {
    color: var(--ink-2);
    max-inline-size: 46ch;
    font-size: var(--step-lede);
    line-height: var(--step-lede-lh);
  }

  .background__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--gap-col);
    align-items: start;
  }

  .background__title {
    font-size: var(--step-subsection);
  }

  .background {
    padding: var(--space-28);
  }

  .background__list {
    list-style: none;
    display: grid;
    gap: var(--space-16);
  }

  .background__item {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    column-gap: var(--space-16);
    align-items: baseline;
    color: var(--ink-2);
    font-size: var(--step-small);
    line-height: var(--step-small-lh);
  }

  .background__no {
    font-size: var(--step-micro);
    letter-spacing: var(--step-mono-tracking);
  }

  .close__inner {
    display: grid;
    gap: var(--space-24);
    justify-items: start;
  }

  .close__address {
    font-family: var(--tgd-font-mono);
  }
</style>
