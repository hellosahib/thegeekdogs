---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyRoom from '../components/floor/EmptyRoom.astro';
import { BACK_TO_STUDIO, NOT_FOUND } from '../lib/copy';

/*
  A headline, one link home, and an empty room — the floor slab and the lamp, no desks
  and no chair, drawn from the floor's own defs.

  COPY.md §9 names none of it on purpose: "A line explaining a visual joke kills the joke
  and doubles the page." So the room carries no caption, no alt text and no second link,
  and the whole scene is aria-hidden.

  The page carries the room it belongs to: the --void ground the studio floor and the
  closing CTA sit on, and one accent link out of it.

  `quietFooter` drops the footer's nav repeat. The empty room is the joke; a nav menu
  underneath it is not. The studio line, the location, the address, the employer note and
  the rights line stay, because they are the footer everywhere else.
*/
---

<BaseLayout
  title={NOT_FOUND.meta.title}
  description={NOT_FOUND.meta.description}
  noindex
  quietFooter
>
  <section class="room empty-room" data-theme-anim>
    <div class="shell empty-room__inner">
      <h1 class="empty-room__title">{NOT_FOUND.headline}</h1>
      <p>
        <a class="link-row" href="/" aria-label={BACK_TO_STUDIO.accessibleName}>
          {BACK_TO_STUDIO.label}
        </a>
      </p>
      <EmptyRoom />
    </div>
  </section>
</BaseLayout>

<style>
  /* The page can be shorter than the viewport, so the one section it has takes the
     growth and the footer sits on the viewport's bottom edge. No bare ground shows
     below the band at any width. */
  .empty-room {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--section-pad);
  }

  .empty-room__inner {
    display: grid;
    gap: var(--space-24);
    justify-items: start;
  }

  .empty-room__title {
    font-size: var(--step-section);
    line-height: var(--step-section-lh);
    letter-spacing: var(--step-section-tracking);
  }

  /* The room stands away from the line that sent you into it. */
  .empty-room :global(.room404) {
    margin-block-start: var(--space-32);
    inline-size: 100%;
  }
</style>
