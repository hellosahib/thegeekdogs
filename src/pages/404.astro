---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPlate from '../components/ContactPlate.astro';
import { BACK_TO_STUDIO } from '../lib/copy';

/*
  COPY.md §9. Four words and one link. DESIGN.md §B.11's empty room is the floor's slab
  and lamp, and the floor scene is not built until step 3, so the page ships with the
  copy and nothing standing in for the artwork.

  Step-1 review item 13: §B.10's address table lists /404 among the pages that print
  thegeekdogs@gmail.com on the plate, and no plate rendered there at any width. It does
  now, in the same sticky wrapper the home page uses — the wrapper is the page's whole
  content, because /404 has neither a hero to leave nor a final CTA to retire into.

  Step-1 review item 15: the page is shorter than the viewport, so the section grows to
  fill it and the footer band sits on the viewport's bottom edge. No bare sheet shows
  below the band at any width.
*/
---

<BaseLayout
  title="Page not found | TheGeekDogs"
  description="That page isn't here. One link back to the studio, and nothing else on it."
  noindex
>
  <div class="plate-span plate-span--page">
    <section class="section">
      <div class="shell stack">
        <h1>This page isn't here.</h1>
        <p>
          <a class="link" href="/" aria-label={BACK_TO_STUDIO.accessibleName}>
            {BACK_TO_STUDIO.label}
          </a>
        </p>
      </div>
    </section>
    <ContactPlate />
  </div>
</BaseLayout>

<style>
  /* The wrapper is the page here, so the one section it holds takes the growth and the
     footer stays on the viewport's bottom edge (step-1 review item 15). */
  .section {
    flex: 1 0 auto;
  }
</style>
