# Firebase web app config for Analytics (QUESTIONS.md item 35).
#
# Copy to .env and fill from the Firebase console:
#   Project settings -> General -> Your apps -> Web app -> SDK setup and configuration.
# In CI these are repository secrets, injected as environment variables at build time.
#
# The site builds and deploys correctly with every one of these unset. When they
# are missing, src/components/Analytics.astro emits nothing and no Firebase
# chunk is generated, so a build without them is a smaller build, not a broken one.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=
